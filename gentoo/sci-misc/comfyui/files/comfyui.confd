# /etc/conf.d/comfyui
# COMFYUI_PORT=8188
# COMFYUI_DATA=/var/lib/comfyui      # models/ output/ input/ user/ custom_nodes/ (its own ZFS dataset rpool/comfyui)
# COMFYUI_EXTRA_ARGS=""              # e.g. --fast fp16_accumulation (the Windows run_nvidia_gpu_fast_fp16_accumulation.bat)
# COMFYUI_LISTEN=                    # empty = wait for the Tailscale IPv4 and bind it only; set 127.0.0.1 for local tests
