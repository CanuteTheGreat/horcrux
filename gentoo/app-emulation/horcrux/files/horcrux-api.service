[Unit]
Description=Horcrux API Server
After=network.target podman.socket docker.service

[Service]
Type=simple
User=root
# ports below 1024 (443, 80); explicit so a hardened drop-in that narrows the bounding set cannot silently lose them
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/horcrux-api
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
