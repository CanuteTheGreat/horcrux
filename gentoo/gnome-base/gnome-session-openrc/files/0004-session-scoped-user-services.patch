diff --git a/src/leader-openrc.c b/src/leader-openrc.c
index a000ee9..56e143a 100644
--- a/src/leader-openrc.c
+++ b/src/leader-openrc.c
@@ -26,6 +26,11 @@
 #include <gio/gio.h>
 #include <sys/syslog.h>
 #include <rc.h>
+#include <sys/wait.h>
+
+#ifndef HELPER_PATH
+#define HELPER_PATH "/usr/libexec/gnome-session-openrc-helper"
+#endif
 
 typedef struct {
         GDBusConnection *session_bus;
@@ -56,6 +61,36 @@ async_run_cmd (gchar **argv, GError **error)
                              error);
 }
 
+/* Session scoping: the OpenRC user runlevel is shared by every login of the user, so the graphical services must be stopped
+   and cleaned up by the graphical session itself (see gnome-session-openrc-helper). The helper runs in its own session
+   (setsid) so that logind / GDM killing the session's processes cannot cut the teardown short. */
+static void
+helper_setup_cb (gpointer data)
+{
+        setsid ();
+}
+
+static void
+run_helper (const char *verb, const char *session_id)
+{
+        g_autoptr (GError) err = NULL;
+        gchar *argv[] = { (gchar *) HELPER_PATH, (gchar *) verb, (gchar *) session_id, NULL };
+        gint status = 0;
+        GPid pid;
+
+        if (!g_spawn_async (NULL, argv, NULL, G_SPAWN_DO_NOT_REAP_CHILD, helper_setup_cb, NULL, &pid, &err)) {
+                g_warning ("Failed to run %s %s: %s", HELPER_PATH, verb, err->message);
+                return;
+        }
+        /* bounded wait: the helper stops services (up to 45s); the leader must not hang the session end forever */
+        for (int i = 0; i < 600; i++) {
+                if (waitpid (pid, &status, WNOHANG) == pid)
+                        return;
+                g_usleep (100 * 1000);
+        }
+        g_warning ("%s %s still running, not waiting", HELPER_PATH, verb);
+}
+
 static gboolean
 leader_term_or_int_signal_cb (gpointer data)
 {
@@ -162,6 +197,10 @@ main (int argc, char **argv)
         target = g_strdup_printf ("gnome-session-%s.%s",
                                   session_type ? session_type : "wayland", session_name);
 
+        /* a stale earlier session of this user (leader gone, session closed, a supervised gnome-shell that was respawned
+           into it) is cleaned up first, so this login can always take control of the seat */
+        run_helper ("preclean", g_getenv ("XDG_SESSION_ID"));
+
         RC_SERVICE state = rc_service_state(target);
         switch (state)
         {
@@ -191,6 +230,16 @@ main (int argc, char **argv)
         // because we later get at /proc/{whatami}/environ. Later this
         // shouldn't be the case, but it is for now.
         pid_t whatami = getpid();
+        {
+                /* which logind session this leader serves: the guard / teardown compare against it */
+                g_autofree char *sid_path = g_build_filename (g_get_user_runtime_dir (), "gnome-session-leader.session", NULL);
+                const char *sid = g_getenv ("XDG_SESSION_ID");
+                g_remove (sid_path);
+                if (sid && !g_file_set_contents (sid_path, sid, -1, &error)) {
+                        g_warning ("Couldn't write %s: %s", sid_path, error->message);
+                        g_clear_error (&error);
+                }
+        }
         pid_path = g_build_filename (g_get_user_runtime_dir (),
                                      "gnome-session-leader.pid",
                                      NULL);
@@ -227,5 +276,8 @@ main (int argc, char **argv)
         g_unix_signal_add (SIGINT, leader_term_or_int_signal_cb, &ctx);
 
         g_main_loop_run (ctx.loop);
+
+        /* the graphical session is over: stop its user services even if other logins of the user keep the runlevel alive */
+        run_helper ("teardown", g_getenv ("XDG_SESSION_ID"));
         return 0;
 }
