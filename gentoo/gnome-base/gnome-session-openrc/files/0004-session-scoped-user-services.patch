From: Horcrux <horcrux@errant.solutions>
Subject: [PATCH] session-scoped user services: stop with the graphical session, never respawn into a dead one

The OpenRC user runlevel is shared by every login of the user (pam_openrc stops it only with the LAST session), so an ssh/su
login kept gnome-shell & co. running after a GNOME logout and supervise-daemon respawned gnome-shell into the closed session:
it grabbed the seat (mutter: "Failed to take control of the session: EBUSY") and the next login had no mouse and keyboard.

* gnome-session-openrc-helper: teardown (stop the session's services), preclean (a new session removes the stale state of an
  earlier one, kills a stale compositor of another session) and guard (exec gnome-shell only while its session is alive)
* leader-openrc: records the logind session, runs preclean before starting and teardown (own setsid, bounded) when the session ends
* gnome-shell-{wayland,x11}[.gnome-login]: command runs through the guard, so a supervise-daemon respawn after the session is
  gone fails instead of starting a compositor
---
diff --git a/data/gnome-session-openrc-helper b/data/gnome-session-openrc-helper
new file mode 100755
index 0000000..dba51a2
--- /dev/null
+++ b/data/gnome-session-openrc-helper
@@ -0,0 +1,173 @@
+#!/bin/sh
+#
+# Session scoping for the OpenRC user services of a GNOME session.
+#
+# OpenRC user services (gnome-shell, gsd-*, dbus, ...) belong to the USER's runlevel, which pam_openrc shares between ALL
+# logins of the user and only stops with the LAST one. Anything that keeps another login open (ssh, su, cron-less agents)
+# therefore kept the graphical services of a logged-out GNOME session alive, and supervise-daemon happily respawned
+# gnome-shell into the dead session where it grabbed the seat (mutter: "Failed to take control of the session: EBUSY",
+# the next login has no mouse and keyboard). This helper makes the GRAPHICAL session the owner of those services:
+#
+#   teardown   stop everything the graphical session started (the user's runlevel goes back to "default"), but only when
+#              this session is still the current one (a newer login keeps its services)
+#   preclean   called by the leader of a NEW session: a stale previous session (leader gone or session closed) is torn
+#              down and a stale compositor of this user that belongs to another session is killed
+#   guard CMD  exec CMD only while the session that started the service is alive: supervise-daemon respawns the command
+#              itself, so this is where "respawn only on a crash while the session is alive" is decided
+#   alive ID   exit 0 while logind session ID exists and is not closing
+#
+# Everything works on the caller's own XDG_RUNTIME_DIR and uid; nothing here touches another user's or another session's
+# services.
+
+PATH="/usr/local/libexec:/usr/libexec:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
+TAG=gnome-session-openrc
+log() { logger -t "$TAG" -- "$*" 2>/dev/null; }
+
+# alive = logind still has the session and it is not closing ("opening" counts: GDM starts the greeter's services while its session is
+# still being set up, and a guard that refused then left the greeter without a shell). Read from logind's runtime state file, NOT over
+# D-Bus: the guard runs while a session is being torn down, and a loginctl call blocked there for minutes (it held the shell's
+# supervise-daemon alive into the next login). loginctl (bounded) only where no state file directory exists.
+session_alive() {
+	local st f
+	[ -n "$1" ] || return 1
+	for f in /run/systemd/sessions /run/elogind/sessions; do
+		[ -d "$f" ] || continue
+		[ -f "$f/$1" ] || return 1
+		st=$(sed -n 's/^STATE=//p' "$f/$1" 2>/dev/null)
+		case "$st" in closing) return 1 ;; esac
+		return 0
+	done
+	st=$(timeout 5 loginctl show-session "$1" -p State --value 2>/dev/null) || return 1
+	case "$st" in ""|closing) return 1 ;; esac
+	return 0
+}
+
+leader_file() { echo "${XDG_RUNTIME_DIR}/gnome-session-leader.$1"; }
+
+# session id of the process $1 (its environment), empty when unreadable
+proc_session() { tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | sed -n 's/^XDG_SESSION_ID=//p' | head -n1; }
+
+# gnome-shell processes of this uid that do not belong to session $1 (pids)
+stale_shells() {
+	local p
+	for p in $(pgrep -u "$(id -u)" -x gnome-shell 2>/dev/null); do
+		[ "$(proc_session "$p")" = "$1" ] || echo "$p"
+	done
+}
+
+kill_stale_shells() {
+	local mine="$1" p pids
+	pids=$(stale_shells "$mine")
+	[ -n "$pids" ] || return 0
+	log "killing stale gnome-shell $pids (not session ${mine:-none})"
+	kill -TERM $pids 2>/dev/null
+	for p in 1 2 3 4 5 6; do
+		sleep 0.5
+		pids=$(stale_shells "$mine")
+		[ -z "$pids" ] && return 0
+	done
+	kill -KILL $pids 2>/dev/null
+}
+
+# Supervisors (and their guards) of the graphical session's services that are still there after the runlevel change. gnome-shell's
+# service never reaches "started" in OpenRC's state (its start is reported failed while supervise-daemon keeps it running), so
+# `openrc -U default` does not stop it: its supervise-daemon would keep respawning into the closed session and, with its pidfile and
+# notify socket left behind, the next login's start of the same service fails (no shell, "Session never registered").
+# SIGTERM makes supervise-daemon stop its child, mark the service stopped and remove its pidfile; KILL only as the last resort.
+kill_leftovers() {
+	local uid pids p s n
+	uid=$(id -u)
+	pids=$( { pgrep -u "$uid" -f '^supervise-daemon (gnome-shell|gnome-session|gnome-settings-daemon|gsd)'; \
+		pgrep -u "$uid" -f 'gnome-session-openrc-helper guard '; } 2>/dev/null | grep -vx "$$")
+	if [ -n "$pids" ]; then
+		log "stopping leftover session service supervisors: $(echo $pids)"
+		kill -TERM $pids 2>/dev/null
+		for p in $(seq 1 40); do
+			sleep 0.25
+			pids=$(for p in $pids; do [ -d "/proc/$p" ] && echo "$p"; done)
+			[ -z "$pids" ] && break
+		done
+		if [ -n "$pids" ]; then
+			log "killing supervisors that did not stop: $(echo $pids)"
+			kill -KILL $pids 2>/dev/null
+		fi
+	fi
+	# notify sockets (and pidfiles) of supervisors that are gone: supervise-daemon's bind() of the next start fails on a stale socket
+	for s in "${XDG_RUNTIME_DIR}"/openrc/supervise-*.sock; do
+		[ -S "$s" ] || continue
+		n=${s##*/supervise-}; n=${n%.sock}
+		pgrep -u "$uid" -f "^supervise-daemon ${n} " >/dev/null 2>&1 || rm -f "$s"
+	done
+	for s in "${XDG_RUNTIME_DIR}"/gnome-shell-*.pid; do
+		[ -f "$s" ] || continue
+		p=$(cat "$s" 2>/dev/null)
+		[ -n "$p" ] && [ -d "/proc/$p" ] || rm -f "$s"
+	done
+}
+
+stop_services() {
+	# the user runlevel is left at "default": everything the graphical session pulled in is stopped, the user's own
+	# default-runlevel services (and any non-graphical login) stay
+	timeout 45 /sbin/openrc -U default >/dev/null 2>&1
+}
+
+cmd_teardown() {
+	local sid="${1:-$XDG_SESSION_ID}" cur
+	[ -n "$XDG_RUNTIME_DIR" ] || exit 0
+	cur=$(cat "$(leader_file session)" 2>/dev/null)
+	if [ -n "$cur" ] && [ -n "$sid" ] && [ "$cur" != "$sid" ] && session_alive "$cur"; then
+		log "session $sid ended, but session $cur of the same user is live: services kept"
+		exit 0
+	fi
+	log "session ${sid:-?} ended: stopping its user services"
+	stop_services
+	kill_leftovers
+	kill_stale_shells "$cur"
+	if [ -z "$cur" ] || [ "$cur" = "$sid" ]; then
+		rm -f "$(leader_file pid)" "$(leader_file session)" "${XDG_RUNTIME_DIR}/gnome-session-leader-fifo"
+	fi
+	exit 0
+}
+
+cmd_preclean() {
+	local sid="${1:-$XDG_SESSION_ID}" old oldsid
+	[ -n "$XDG_RUNTIME_DIR" ] || exit 0
+	old=$(cat "$(leader_file pid)" 2>/dev/null)
+	oldsid=$(cat "$(leader_file session)" 2>/dev/null)
+	if [ -n "$old" ] && [ -d "/proc/$old" ] && [ "$oldsid" != "$sid" ] && session_alive "$oldsid" \
+	   && [ "$(proc_session "$old")" = "$oldsid" ]; then
+		log "session $oldsid of this user is still live: leaving its services alone"
+		exit 0
+	fi
+	# stale state of an earlier session: dead leader, closed session, a leftover supervised compositor
+	if [ -n "$old" ] || [ -n "$oldsid" ] || [ -n "$(stale_shells "$sid")" ] || \
+	   pgrep -u "$(id -u)" -f '^supervise-daemon (gnome-|gsd)' >/dev/null 2>&1; then
+		log "new session ${sid:-?}: cleaning the stale services of session ${oldsid:-?}"
+		stop_services
+		kill_leftovers
+		kill_stale_shells "$sid"
+	fi
+	exit 0
+}
+
+cmd_guard() {
+	local sid="${XDG_SESSION_ID:-}" cur lp
+	# no session id: started by hand, behave like a plain service
+	[ -n "$sid" ] && [ -n "$XDG_RUNTIME_DIR" ] || exec "$@"
+	cur=$(cat "$(leader_file session)" 2>/dev/null)
+	# (the leader writes its pid without a trailing newline: cat, not read)
+	lp=$(cat "$(leader_file pid)" 2>/dev/null)
+	if ! session_alive "$sid" || [ "$cur" != "$sid" ] || [ -z "$lp" ] || [ ! -d "/proc/$lp" ]; then
+		log "session $sid is gone (current: ${cur:-none}): not starting $1"
+		exit 1
+	fi
+	exec "$@"
+}
+
+case "$1" in
+	teardown) shift; cmd_teardown "$@" ;;
+	preclean) shift; cmd_preclean "$@" ;;
+	guard)    shift; cmd_guard "$@" ;;
+	alive)    session_alive "$2" ;;
+	*) echo "usage: ${0##*/} teardown|preclean [SESSION_ID] | guard CMD... | alive SESSION_ID" >&2; exit 2 ;;
+esac
diff --git a/data/meson.build b/data/meson.build
index d21f1d5..20215a4 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -61,6 +61,13 @@ install_data(
   install_dir: session_libexecdir
 )
 
+# Session scoping helper (teardown / preclean / respawn guard), see the header of the script
+install_data(
+  'gnome-session-openrc-helper',
+  install_dir: session_libexecdir,
+  install_mode: 'rwxr-xr-x'
+)
+
 # Create services like gnome-session.{gnome,gnome-login,...}
 gnome_sessions = [ 'gnome', 'gnome-login', 'gnome-initial-setup' ]
 targets = [
diff --git a/data/openrc/gnome-shell-wayland b/data/openrc/gnome-shell-wayland
index b478d00..531ae72 100755
--- a/data/openrc/gnome-shell-wayland
+++ b/data/openrc/gnome-shell-wayland
@@ -8,8 +8,10 @@ error_logger="logger"
 
 supervisor=supervise-daemon
 description="GNOME Shell (wayland)"
-command="/usr/bin/gnome-shell"
-command_args="--wayland"
+# supervise-daemon respawns the command itself: the guard starts gnome-shell only while the graphical session that owns this
+# service is alive (a respawn into a closed session would grab the seat and the next login would have no input)
+command="/usr/libexec/gnome-session-openrc-helper"
+command_args="guard /usr/bin/gnome-shell --wayland"
 notify="socket:ready"
 
 pidfile="${XDG_RUNTIME_DIR}/gnome-shell-wayland.pid"
diff --git a/data/openrc/gnome-shell-wayland.gnome-login b/data/openrc/gnome-shell-wayland.gnome-login
index 398c60c..687061c 100755
--- a/data/openrc/gnome-shell-wayland.gnome-login
+++ b/data/openrc/gnome-shell-wayland.gnome-login
@@ -8,8 +8,10 @@ error_logger="logger"
 
 supervisor=supervise-daemon
 description="GNOME Shell (login)"
-command="/usr/bin/gnome-shell"
-command_args="--wayland --mode=gdm"
+# supervise-daemon respawns the command itself: the guard starts gnome-shell only while the graphical session that owns this
+# service is alive (a respawn into a closed session would grab the seat and the next login would have no input)
+command="/usr/libexec/gnome-session-openrc-helper"
+command_args="guard /usr/bin/gnome-shell --wayland --mode=gdm"
 notify="socket:ready"
 
 pidfile="${XDG_RUNTIME_DIR}/gnome-shell-gdm.pid"
