--- a/data/openrc/gsd-xsettings
+++ b/data/openrc/gsd-xsettings
@@ -1,13 +1,57 @@
 #!/sbin/openrc-run
 
+# gsd-xsettings publishes the X11 desktop settings for X11 apps under Xwayland: the XSETTINGS manager (Gdk/WindowScalingFactor, Xft/DPI,
+# fonts, theme) and the Xft.* X resources. Since mutter 50, Xwayland always runs natively scaled: on a monitor at a fractional scale
+# (1.25, 1.33, 1.5) the X screen has ceil(scale) times the logical size and the compositor scales X11 windows down. An X11 app only gets
+# the right size when it renders at that integer factor, and it learns the factor only from what gsd-xsettings publishes (mutter's
+# org.gnome.Mutter.X11 UiScalingFactor -> Gdk/WindowScalingFactor, Xft.dpi = 96 x factor x text-scaling-factor). GTK, Qt, SDL (Steam),
+# Chromium/Electron on X11 and Java read it and follow changes live. Without it Steam, the Nextcloud client, terminator ... render at
+# factor 1 and come out tiny.
+#
+# Under systemd gnome-session starts it when Xwayland comes up. Here mutter runs /etc/xdg/Xwayland-session.d/20-gnome-session-openrc-xsettings
+# when it starts Xwayland; that records the display and starts this service. Nothing is hard-coded: the display is the one mutter started
+# (upstream had DISPLAY=:2 here), the factor comes from mutter at runtime.
+
 DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
 export DBUS_SESSION_BUS_ADDRESS
-DISPLAY=:2
-export DISPLAY
+output_logger="logger"
+error_logger="logger"
 
 supervisor=supervise-daemon
-description="${RC_SVCNAME} daemon"
-command="/usr/libexec/${RC_SVCNAME}"
-command_args=""
-command_background="true"
+description="GNOME X11 settings (XSETTINGS, Xft.dpi) for Xwayland apps"
+# supervise-daemon respawns the command itself: the guard starts it only while the graphical session that owns it is alive
+command="/usr/libexec/gnome-session-openrc-helper"
+command_args="guard /usr/libexec/gsd-xsettings"
 pidfile="${XDG_RUNTIME_DIR}/${RC_SVCNAME}.pid"
+_gsl_file="${XDG_RUNTIME_DIR}/gnome-session-leader.pid"
+
+depend() {
+	after dbus gnome-session-dbus.gnome gnome-shell
+}
+
+start_pre() {
+	local d
+	if ! [ -f "${_gsl_file}" ]; then
+		eerror "${_gsl_file} doesn't exist: no GNOME session of this user"
+		return 1
+	fi
+	# the session environment (XDG_SESSION_ID for the guard, the desktop identity) comes from the session leader, as for gnome-shell
+	while read -d $'\0' line; do
+		export "${line}"
+	done < /proc/$(cat "${_gsl_file}")/environ
+	export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
+	d=$(/usr/libexec/gnome-session-openrc-helper x-display)
+	if [ -z "$d" ]; then
+		eerror "no Xwayland display of this session yet (the service starts together with Xwayland)"
+		return 1
+	fi
+	export DISPLAY="$d"
+	# Xwayland only lets clients with its cookie in
+	d=$(/usr/libexec/gnome-session-openrc-helper x-authority)
+	if [ -z "$d" ]; then
+		eerror "no X authority file of this session's Xwayland"
+		return 1
+	fi
+	export XAUTHORITY="$d"
+	return 0
+}
