#!/bin/sh
# surface-osk toggle|show|hide : drive the wvkbd on-screen keyboard (signals: SIGUSR1 hide, SIGUSR2 show, SIGRTMIN toggle)
pid=$(pgrep -x wvkbd-mobintl | head -1)
if [ -z "$pid" ]; then
    wvkbd-mobintl --hidden -L 320 -fn "DejaVu Sans 18" >/dev/null 2>&1 &
    sleep 1; pid=$(pgrep -x wvkbd-mobintl | head -1)
fi
case "${1:-toggle}" in
    show) kill -USR2 "$pid" ;;
    hide) kill -USR1 "$pid" ;;
    *)    kill -RTMIN "$pid" ;;
esac
