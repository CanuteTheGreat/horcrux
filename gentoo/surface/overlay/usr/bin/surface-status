#!/usr/bin/env python3
"""surface-status: swaybar status line with tappable buttons (i3bar protocol with click_events).

[Keyboard] toggles the on-screen keyboard, [Apps] opens the launcher, [Wi-Fi] opens nmtui, [Term] a terminal.
Battery / Wi-Fi / clock refresh every 5 s. No dependencies beyond Python and (optionally) nmcli.
"""
import glob
import json
import os
import subprocess
import sys
import threading
import time

ACTIONS = {
    "kbd": ["surface-osk", "toggle"],
    "apps": ["wmenu-run", "-f", "DejaVu Sans 16"],
    "wifi": ["foot", "-e", "nmtui"],
    "term": ["foot"],
}


def battery():
    for d in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        try:
            cap = open(d + "/capacity").read().strip()
            st = open(d + "/status").read().strip()
            return f"Bat {cap}%{'+' if st == 'Charging' else ''}"
        except OSError:
            continue
    return "AC"


def wifi():
    try:
        r = subprocess.run(["nmcli", "-t", "-f", "active,ssid", "dev", "wifi"], capture_output=True, text=True, timeout=3)
        for line in r.stdout.splitlines():
            if line.startswith("yes:"):
                return "Wi-Fi " + line[4:]
    except Exception:
        pass
    return "Wi-Fi"


def block(name, text, **kw):
    b = {"name": name, "full_text": f" {text} ", "separator": True, "separator_block_width": 14, "min_width": 80}
    b.update(kw)
    return b


def render():
    return [block("kbd", "[Keyboard]", color="#79c0ff"), block("apps", "[Apps]", color="#79c0ff"), block("term", "[Term]", color="#79c0ff"),
            block("wifi", f"[{wifi()}]", color="#79c0ff"), block("bat", battery()), block("clock", time.strftime("%a %d %b %H:%M"))]


def clicks():
    for line in sys.stdin:
        line = line.strip().lstrip(",[").strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        cmd = ACTIONS.get(ev.get("name"))
        if cmd and ev.get("button", 1) in (1, 272):
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    print(json.dumps({"version": 1, "click_events": True}), flush=True)
    print("[", flush=True)
    threading.Thread(target=clicks, daemon=True).start()
    while True:
        print(json.dumps(render()) + ",", flush=True)
        time.sleep(5)


if __name__ == "__main__":
    main()
