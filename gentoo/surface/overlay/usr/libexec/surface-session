#!/bin/sh
# Starts the Surface desktop (sway on Wayland) from a console login. Called by /etc/profile.d/surface-session.sh.
# Environment decisions live here so they can be read in one place.
[ -n "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ] || {
    XDG_RUNTIME_DIR=/run/user/$(id -u)
    [ -d "$XDG_RUNTIME_DIR" ] || { XDG_RUNTIME_DIR=/tmp/xdg-$(id -u); mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"; }
    export XDG_RUNTIME_DIR
}
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM=wayland SDL_VIDEODRIVER=wayland _JAVA_AWT_WM_NONREPARENTING=1
# keyboard layout: the console keymap chosen in the installer (/etc/conf.d/keymaps) is the best hint we have
km=$(sed -n 's/^keymap="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/conf.d/keymaps 2>/dev/null | head -1)
lay=${km%%[-_.]*}
case "$lay" in us|de|fr|es|it|pt|se|no|dk|fi|nl|pl|cz|ru|uk|gb|ch|be|hu|tr|jp) ;; *) lay=us ;; esac
[ "$lay" = uk ] && lay=gb
export XKB_DEFAULT_LAYOUT=$lay
# software rendering in virtual machines (no GL there; QEMU's virtio-vga/std VGA); real hardware uses Mesa's GPU drivers
if grep -qw hypervisor /proc/cpuinfo 2>/dev/null; then
    export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
fi
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}" 2>/dev/null
exec dbus-run-session sway --unsupported-gpu >"${XDG_STATE_HOME:-$HOME/.local/state}/sway.log" 2>&1
