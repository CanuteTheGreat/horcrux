# Pinned inputs for the OPTIONAL linux-surface kernel (Surface Pro 3 and newer; NOT used for the Surface Pro 1/2).
# linux-surface/linux-surface @ d4dc510e3e0a2ee60879f0114a0ef356200b590d (2026-11-11).
# Default series = 6.18 = the kernel the Horcrux ISO ships (gentoo-kernel-bin 6.18.57-gentoo-dist-bin).
# For a ZFS-root/T2-style 7.2 kernel use LS_SERIES=7.2 KERNEL_VERSION=7.2.13 (docs/T2-MACS.md: OpenZFS 2.4.x supports <= 7.2).
LS_COMMIT=d4dc510e3e0a2ee60879f0114a0ef356200b590d
LS_SERIES=${LS_SERIES:-6.18}
KERNEL_VERSION=${KERNEL_VERSION:-6.18.63}
