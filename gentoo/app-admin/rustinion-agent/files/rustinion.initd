#!/sbin/openrc-run
# Rustinion agent (resident mode). Daemon flags live in /etc/rustinion/daemon.env, which
# `rustinion service install` writes for a package-managed agent (the same file the systemd unit reads).

name="rustinion"
description="Rustinion agent (device management and monitoring)"

RUSTINION_DAEMON_ARGS="--interval-minutes 60"
if [ -r /etc/rustinion/daemon.env ]; then
	. /etc/rustinion/daemon.env
fi

supervisor="supervise-daemon"
command="/usr/bin/rustinion"
command_args="daemon ${RUSTINION_DAEMON_ARGS}"
# apt/dnf/emerge installs and OS-update installs need root.
command_user="root"
respawn_delay=30
respawn_max=0
export RUST_LOG="${RUST_LOG:-info}"

depend() {
	need net
	after net-online
}

# Resident daemon output: without a log the supervisor leaves stdout on whatever started the service (an ssh session, a
# pipe): once that reader is gone the first println! panics with 'Broken pipe' and the daemon dies at every check-in
# (lab 2026-11-06: crash.log hourly, last full report 38 h old on a Portage-owned agent).
output_log="/var/log/rustinion.log"
error_log="/var/log/rustinion.log"
