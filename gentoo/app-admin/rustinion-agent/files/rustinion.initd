#!/sbin/openrc-run
# Rustinion agent (resident mode). Daemon flags live in /etc/rustinion/daemon.env, which
# `rustinion service install` writes for a package-managed agent (the same file the systemd unit reads).

name="rustinion"
description="Rustinion agent (device management and monitoring)"

RUSTINION_DAEMON_ARGS="--interval-minutes 60"
if [ -r /etc/rustinion/daemon.env ]; then
	. /etc/rustinion/daemon.env
fi

supervisor="supervise-daemon"
command="/usr/bin/rustinion"
command_args="daemon ${RUSTINION_DAEMON_ARGS}"
# apt/dnf/emerge installs and OS-update installs need root.
command_user="root"
respawn_delay=30
respawn_max=0
export RUST_LOG="${RUST_LOG:-info}"

depend() {
	need net
	after net-online
}
