[Unit]
Description=test machine: follow the kernel ring buffer into /var/log/kernel-test.log
# persistent kernel log; rotated by /etc/logrotate.d/horcrux-test-machine
After=local-fs.target
Before=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/horcrux-test-klog
Restart=on-failure

[Install]
WantedBy=multi-user.target
