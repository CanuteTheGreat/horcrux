# Paths (relative to / ) and per-user paths (relative to each home, incl. /root) that must not exist on a TEST machine.
# `/` prefix = system path, `~/` prefix = under every home. Shell globs. Used by horcrux-test-machine-check.
/opt/discord*
/opt/proton*
/opt/nextcloud*
/opt/1Password*
/opt/signal*
/opt/spotify*
/opt/keepassxc*
/usr/local/bin/*.AppImage
/usr/share/applications/*nextcloud*
/usr/share/applications/*discord*
/usr/share/applications/*proton*
/usr/share/applications/*spotify*
/usr/share/applications/*signal*
/usr/share/applications/*keepass*
/usr/share/applications/*steam*
/etc/xdg/autostart/*nextcloud*
/etc/xdg/autostart/*discord*
/etc/xdg/autostart/*proton*
/etc/xdg/autostart/*spotify*
/etc/ctg-backup/env
/etc/ctg-backup/repo.pw
/var/lib/flatpak/app/*
~/Nextcloud
~/.config/Nextcloud
~/.local/share/Nextcloud
~/.cache/Nextcloud
~/.config/discord
~/.config/Signal
~/.config/spotify
~/.config/KeePassXC
~/.config/keepassxc
~/.local/share/keepassxc
~/.config/Proton*
~/.config/proton*
~/.local/share/protonvpn
~/.config/syncthing
~/.config/rclone
~/.config/autostart/*[Nn]extcloud*
~/.config/autostart/*[Bb]rave*
~/.config/autostart/*[Dd]iscord*
~/.config/autostart/*[Pp]roton*
~/.config/autostart/*[Ss]potify*
~/.config/autostart/*[Ss]ignal*
~/.config/autostart/*[Kk]eepass*
~/.local/share/applications/*[Bb]rave*
~/.local/share/applications/*[Nn]extcloud*
~/.local/share/applications/*[Dd]iscord*
~/.local/share/applications/*[Pp]roton*
~/.ssh/id_*
~/.gnupg/private-keys-v1.d/*.key
~/.var/app/*
# the owner's private gringotts image layer (gringotts-config/-tools): private first-boot/remote hand-off/restore tools and personal overlays
/usr/bin/gringotts-*
/usr/libexec/gringotts-*
/etc/init.d/gringotts-*
/etc/gringotts
/etc/gringotts/*
/var/lib/gringotts
/etc/ssh/sshd_config.d/10-gringotts.conf
/etc/portage/repos.conf/gringotts.conf
/var/db/repos/horcrux-gringotts
/var/db/repos/canutethegreat-overlay
# Portage repositories that must not be configured (any repos.conf file with a [section] of that name)
repo:canutethegreat-overlay
repo:horcrux-gringotts
# Tailscale is retired (2026-11-10): no daemon state, init script or binary may remain
/var/lib/tailscale
/etc/init.d/tailscale*
/usr/bin/tailscale*
/usr/sbin/tailscale*
/run/tailscale
