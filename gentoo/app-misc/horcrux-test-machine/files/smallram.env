# app-misc/horcrux-test-machine USE=smallram: heavy packages build with ONE job on a <=4 GB machine (madammalkins: a source build of
# clang-22 with -j4 starved the Wi-Fi driver of memory on 2026-11-04). Prefer binary packages (--getbinpkg is on by default there).
MAKEOPTS="-j1"
NINJAOPTS="-j1"
CARGO_BUILD_JOBS=1
