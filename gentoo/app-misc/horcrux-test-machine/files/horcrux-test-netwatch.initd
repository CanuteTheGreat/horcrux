#!/sbin/openrc-run
# app-misc/horcrux-test-machine: network + boot-health watchdog (see /usr/libexec/horcrux-test-netwatch, settings /etc/conf.d/horcrux-test-netwatch)
description="test machine: coldplug + restart NetworkManager when no link is up after boot, boot-health report, Wi-Fi driver reload on lost connectivity"
command=/usr/libexec/horcrux-test-netwatch
command_background=true
pidfile=/run/horcrux-test-netwatch.pid
depend() {
	# not `need NetworkManager`: the watchdog must run exactly when NetworkManager or the device coldplug failed
	after NetworkManager udev-trigger
	use logger
}
