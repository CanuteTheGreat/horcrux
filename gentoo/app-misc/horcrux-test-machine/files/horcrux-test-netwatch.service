[Unit]
Description=test machine: coldplug + restart NetworkManager when no link is up after boot, boot-health report, Wi-Fi driver reload on lost connectivity
# network + boot-health watchdog (see /usr/libexec/horcrux-test-netwatch, settings /etc/conf.d/horcrux-test-netwatch)
# Wants, not Requires: it must run exactly when NetworkManager failed
Wants=NetworkManager.service
After=NetworkManager.service systemd-udev-trigger.service

[Service]
Type=simple
ExecStart=/usr/libexec/horcrux-test-netwatch
Restart=on-failure

[Install]
WantedBy=multi-user.target
