#!/sbin/openrc-run
# app-misc/horcrux-test-machine: runtime power saving off at every boot (Wi-Fi power_save, power-saver profile). The logic is
# /usr/libexec/horcrux-test-power (shared with the systemd unit).
description="test machine: Wi-Fi power save off, no power-saver profile, Wake-on-LAN armed on the wired NICs"
depend() {
	after NetworkManager iwd power-profiles-daemon
}
start() {
	ebegin "Test machine: disabling Wi-Fi power saving, arming Wake-on-LAN"
	/usr/libexec/horcrux-test-power start
	eend 0
}
stop() {
	/usr/libexec/horcrux-test-power stop
	return 0
}
