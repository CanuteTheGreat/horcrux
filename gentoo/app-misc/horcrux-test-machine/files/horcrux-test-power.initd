#!/sbin/openrc-run
# app-misc/horcrux-test-machine: runtime power saving off at every boot (Wi-Fi power_save, power-saver profile)
description="test machine: Wi-Fi power save off, no power-saver profile, Wake-on-LAN armed on the wired NICs"
depend() {
	after NetworkManager iwd power-profiles-daemon
}
# Wake-on-LAN (magic packet) on every wired NIC. The kernel/driver forgets it at every boot (the e1000e default comes from the EEPROM) and the
# lab's HA suite powers laptops off on purpose; a laptop that cannot be woken needs the owner. Done at start AND stop (stop = just before poweroff).
arm_wol() {
	command -v ethtool >/dev/null 2>&1 || return 0
	local d i
	for d in /sys/class/net/*/device; do
		i=${d%/device}; i=${i##*/}
		[ -d "/sys/class/net/${i}/wireless" ] && continue
		[ "${i}" = "lo" ] && continue
		ethtool -s "${i}" wol g >/dev/null 2>&1
		[ -w "${d}/power/wakeup" ] && echo enabled > "${d}/power/wakeup" 2>/dev/null
	done
	return 0
}
stop() {
	arm_wol
	return 0
}
start() {
	arm_wol
	ebegin "Test machine: disabling Wi-Fi power saving"
	for d in /sys/class/net/*/wireless; do
		[ -d "$d" ] || continue
		i=${d%/wireless}; i=${i##*/}
		iw dev "$i" set power_save off 2>/dev/null
	done
	if command -v powerprofilesctl >/dev/null 2>&1 && [ "$(powerprofilesctl get 2>/dev/null)" = "power-saver" ]; then
		powerprofilesctl set balanced 2>/dev/null
	fi
	eend 0
}
