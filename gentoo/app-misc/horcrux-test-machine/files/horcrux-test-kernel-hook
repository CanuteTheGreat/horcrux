#!/bin/sh
# app-misc/horcrux-test-machine: /etc/kernel/postinst.d hook (installkernel runs it after every kernel install/removal):
# make sure a newly installed kernel gets a boot entry. ZFS boot-environment systems (horcrux-be) have a static grub.cfg that GRUB
# renders from /boot/be/<BE>/ (GRUB cannot read encrypted ZFS), so `horcrux-be sync` is the right call there and grub-mkconfig
# would overwrite it; every other system gets grub-mkconfig. Never fails the kernel install.
[ -n "$1" ] || exit 0
if [ -f /etc/horcrux/be.conf ] && command -v horcrux-be >/dev/null 2>&1; then
	horcrux-be sync || echo "horcrux-test-kernel-hook: horcrux-be sync failed" >&2
elif command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
	grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || echo "horcrux-test-kernel-hook: grub-mkconfig failed" >&2
fi
exit 0
