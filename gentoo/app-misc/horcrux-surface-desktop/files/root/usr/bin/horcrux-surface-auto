#!/bin/bash
# horcrux-surface-auto: the whole Surface install on one screen. The owner types the disk passphrase and the desktop password (each twice) and restarts.
#   1. finds the internal disk (never the USB stick) and checks the machine is a Surface
#   2. read-only inventory of the disk: factory-fresh/empty -> goes on by itself; user data (or unreadable/encrypted partitions,
#      or not a Surface) -> asks for the word ERASE first; the report is kept in /root
#   3. asks the disk passphrase twice, then the desktop user's login password twice (it MUST differ from the passphrase: the passphrase
#      is only for the disk; root stays locked, sudo via wheel), builds the answer file in tmpfs, runs the installer (XFS in LUKS2 in LVM, 4.5 GiB encrypted hibernate swap, zram, XFCE) and wipes the answer file
# Anything unexpected -> the guided installer or a shell, never a half decision.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
export TERM=${TERM:-linux}
dmesg -n 1 2>/dev/null
B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; N=$'\e[0m'
PRIV=/usr/share/horcrux-surface-private
USER_NAME=canutethegreat
mark() { echo "SURFACE-AUTO: $*" > /dev/console 2>/dev/null; }
mark START
clear
echo "${B}Horcrux for the Surface Pro${N}  (kernel $(uname -r))"
echo "----------------------------------------------------------------------"
fallback() { echo; echo "${Y}$*${N}"; echo "Starting the guided installer instead."; sleep 3; /usr/bin/live-installer; exec /bin/login -f root; }

dmi_v=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null); dmi_p=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
echo "Machine: ${dmi_v:-?} ${dmi_p:-?}"
case "$dmi_v/$dmi_p" in
    "Microsoft Corporation/Surface"*) is_surface=1 ;;
    *) is_surface=0; echo "${R}This does not look like a Surface (DMI above).${N}" ;;
esac

# the internal disk: not the live medium, not USB, not removable
live_src=$(findmnt -no SOURCE /run/initramfs/live 2>/dev/null)
live_disk=""; [ -n "$live_src" ] && live_disk=$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -1)
cands=()
while read -r name tran rm; do
    [ "$name" = "$live_disk" ] && continue
    [ "$tran" = usb ] && continue
    [ "$rm" = 1 ] && continue
    case "$name" in zram*|loop*|sr*|ram*|dm-*) continue ;; esac
    cands+=("/dev/$name")
done < <(lsblk -dnro NAME,TRAN,RM,TYPE | awk '$4=="disk"{print $1, ($2==""?"-":$2), $3}')
[ ${#cands[@]} -eq 1 ] || fallback "Expected exactly one internal disk, found ${#cands[@]} (${cands[*]:-none})."
DISK=${cands[0]}
echo "Internal disk: $DISK  ($(lsblk -dno SIZE,MODEL "$DISK" | xargs))"

# read-only inventory (what would be erased)
echo; echo "${B}Looking at what is on the disk (read-only)...${N}"
inv=/root/surface-inventory-$(date +%Y%m%d-%H%M%S).txt
/usr/bin/surface-inventory "$DISK" > "$inv" 2>&1; irc=$?
grep -E '^(-- |   Windows user|== summary|RESULT)' "$inv" | sed 's/^/  /'
echo "  (full report: $inv)"
mark "INVENTORY rc=$irc disk=$DISK"
need_confirm=0
[ "$irc" = 0 ] || need_confirm=1
[ "$is_surface" = 1 ] || need_confirm=1
if [ "$need_confirm" = 1 ]; then
    echo
    echo "${R}${B}Personal data (or an unreadable/encrypted partition, or a machine that is not a Surface) was found.${N}"
    echo "Installing ERASES the whole disk. If you need anything on it, switch the tablet off now and tell the assistant."
    printf "Type ${B}ERASE${N} (capitals) to erase the disk and install; anything else opens a shell: "
    read -r ans
    [ "$ans" = ERASE ] || { echo "Not erasing. Shell below."; exec /bin/login -f root; }
else
    echo "${G}Nothing of value on the disk (factory image or empty): installing without further questions.${N}"
fi

mark WAITING-FOR-PASSPHRASE
# the passphrase (typed here, never stored) and the desktop password (a DIFFERENT secret; compared in memory only)
echo
echo "${B}Disk passphrase${N}: typed at every start of the tablet (and once more after hibernate). At least 12 characters."
echo "There is NO recovery: lose it, lose the data. It is ONLY for the disk: the login password of '$USER_NAME' is asked next and must differ."
while :; do
    printf "Passphrase: "; read -rs p1; echo
    [ "${#p1}" -ge 12 ] || { echo "${R}too short (min 12)${N}"; continue; }
    printf "Again:      "; read -rs p2; echo
    [ "$p1" = "$p2" ] && break
    echo "${R}the two entries differ${N}"
done
mark WAITING-FOR-LOGIN-PASSWORD
echo
echo "${B}Login password${N} for '$USER_NAME' (desktop login and sudo). It must be DIFFERENT from the disk passphrase. At least 12 characters."
while :; do
    printf "Password:   "; read -rs u1; echo
    [ "${#u1}" -ge 12 ] || { echo "${R}too short (min 12)${N}"; continue; }
    [ "$u1" != "$p1" ] || { mark LOGIN-PASSWORD-REFUSED-SAME-AS-DISK; echo "${R}That is the disk passphrase. The disk passphrase is only for the disk: choose a different login password.${N}"; continue; }
    printf "Again:      "; read -rs u2; echo
    [ "$u1" = "$u2" ] && break
    echo "${R}the two entries differ${N}"
done

# answer file in tmpfs
d=/run/hx-auto; mkdir -p "$d"; chmod 700 "$d"; ans=$d/answer.toml
uh=$(printf '%s' "$u1" | openssl passwd -6 -stdin)                 # the LOGIN password's hash, never the passphrase's
# root: no password at all (the installer locks it: `passwd -l`); administration is sudo through wheel, ssh is key-only
keys=""
allkeys=$d/keys.txt; : > "$allkeys"
[ -s "$PRIV/authorized_keys" ] && cat "$PRIV/authorized_keys" >> "$allkeys"
# optional extra public keys from a stick labelled SURFKEYS (file: authorized_keys), e.g. for tests or a second admin
kd=$(blkid -L SURFKEYS 2>/dev/null)
if [ -n "$kd" ]; then mkdir -p /run/hx-keys && mount -o ro "$kd" /run/hx-keys 2>/dev/null && { cat /run/hx-keys/authorized_keys >> "$allkeys" 2>/dev/null; umount /run/hx-keys; }; fi
while read -r k; do case "$k" in ssh-*|ecdsa-*|sk-*) keys="$keys\"$k\"," ;; esac; done < "$allkeys"
umask 077
esc=$(printf '%s' "$p1" | sed 's/\\/\\\\/g; s/"/\\"/g')
cat > "$ans" <<TOML
[global]
keyboard = "us"
timezone = "America/Los_Angeles"
hostname = "surface-pro"
email = ""
ssh_keys = [${keys%,}]
ssh_password_auth = false

[disk]
filesystem = "xfs-luks"
luks_passphrase = "$esc"
disks = ["$DISK"]

[desktop]
enable = true
user = "$USER_NAME"
password_hash = "$uh"
autologin = true

[network.management]
mode = "dhcp"
TOML
unset p1 p2 u1 u2 esc
mark "PASSPHRASE-ACCEPTED"
echo; echo "${B}Installing...${N} (15-30 minutes from a USB 3 stick; do not unplug anything)"
/usr/bin/live-installer --answers "$ans" --no-halt 2>&1 | tee /var/log/surface-install.log
rc=${PIPESTATUS[0]}
shred -u "$ans" 2>/dev/null || rm -f "$ans"
# the installed system must be completely written and CLOSED before the owner is told anything: nothing mounted from the target,
# no dm-crypt/LVM mapping left open (the installer's finish() does sync + umount + swapoff + vgchange -an + cryptsetup close; this re-checks it)
target_closed() {
    sync
    if findmnt -rn -o TARGET | grep -qE '^/mnt(/|$)'; then umount -R /mnt/target 2>/dev/null || umount -R /mnt 2>/dev/null; fi
    findmnt -rn -o TARGET | grep -qE '^/mnt(/|$)' && return 1
    if dmsetup ls 2>/dev/null | grep -qE '^(hxroot|hxvg-)'; then
        swapoff -a 2>/dev/null; vgchange -an hxvg >/dev/null 2>&1; cryptsetup close hxroot >/dev/null 2>&1
        dmsetup ls 2>/dev/null | grep -qE '^(hxroot|hxvg-)' && return 1
    fi
    sync
    return 0
}
# The live system runs from the USB stick (the tablet has only 4 GB: no copy-to-RAM), so once the stick is pulled no file on it can be read any
# more. Restart WITHOUT starting a single program from it: bash builtins + the kernel's sysrq (always honoured when written via /proc/sysrq-trigger).
hard_restart() {
    echo s > /proc/sysrq-trigger 2>/dev/null
    echo b > /proc/sysrq-trigger 2>/dev/null
    exec /sbin/reboot -f                          # only if sysrq is not available (needs the stick, last resort)
}
if [ "$rc" = 0 ] && grep -q 'AUTOINSTALL-OK' /var/log/surface-install.log; then
    mark "INSTALL-OK"
    if target_closed; then
        mark "TARGET-CLOSED"
    else
        mark "TARGET-NOT-CLOSED"
        echo; echo "${R}${B}The new system could not be closed cleanly. Do NOT pull the stick.${N} A root shell follows; tell the assistant."
        exec /bin/login -f root
    fi
    echo; echo "${G}${B}Installation successful.${N} The new system is completely written and closed."
    echo "Press Enter: the tablet restarts at once. Pull the USB stick as soon as the screen goes dark (it is safe to pull it any time from now on)."
    read -r _
    mark "RESTARTING"
    hard_restart
fi
mark "INSTALL-FAILED rc=$rc"
echo; echo "${R}${B}The installation did not finish (exit $rc).${N} Log: /var/log/surface-install.log. A root shell follows."
echo "Tell the assistant: join Wi-Fi with  nmtui  and run  surface-remote."
exec /bin/login -f root
