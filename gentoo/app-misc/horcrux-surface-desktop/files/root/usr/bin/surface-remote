#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# surface-remote: sshd (key-only) + Tailscale with the baked ephemeral, tagged, 7-day pre-auth key. Needs a network (nmtui for Wi-Fi).
set -u
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
SOCK=/run/tailscale/tailscaled.sock
KEY=/usr/share/horcrux-surface-private/ts-authkey
HOST=surface-pro; [ -d /run/live-installer ] && HOST=surface-live
ts() { tailscale --socket=$SOCK "$@"; }
lanips() { ip -4 -o addr show scope global 2>/dev/null | awk '$2!="tailscale0"{split($4,a,"/"); print "  " a[1] "  (" $2 ")"}'; }
echo "== network"
if ! ip -4 route show default | grep -q .; then
  echo "No default route: the tablet is not online yet."
  echo "  Wi-Fi:  nmtui   (Activate a connection)      USB Ethernet adapter: plug it in, DHCP is automatic"
  exit 1
fi
ip -4 route show default | head -2
echo "== sshd (key-only)"
if [ -s /usr/share/horcrux-surface-private/authorized_keys ]; then
  mkdir -p /root/.ssh; chmod 700 /root/.ssh
  cp -n /usr/share/horcrux-surface-private/authorized_keys /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
fi
rc-service sshd status >/dev/null 2>&1 || rc-service sshd start >/dev/null 2>&1
rc-service sshd status 2>&1 | tail -1
echo "== clock"
d=$(curl -sI -m 8 http://www.google.com 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | head -1)
if [ -n "$d" ] && date -u -s "$d" >/dev/null 2>&1; then echo "clock set to: $(date -u)"; else echo "clock left as: $(date -u)"; fi
echo "== tailscale"
hostname "$HOST" 2>/dev/null
modprobe tun 2>/dev/null
for s in tailscale tailscaled; do
  if [ -x /etc/init.d/$s ]; then rc-service $s status >/dev/null 2>&1 || rc-service $s start >/dev/null 2>&1; break; fi
done
i=0; while [ ! -S $SOCK ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done
if ts status --json 2>/dev/null | grep -q '"BackendState": "Running"'; then
  echo "already connected"
elif [ ! -s "$KEY" ]; then
  echo "No auth key in this image ($KEY). Run:  tailscale up --hostname=$HOST   and open the URL."
elif ! ts up --auth-key="file:$KEY" --hostname="$HOST" --accept-dns=false --accept-routes=false --ssh=false --timeout=60s; then
  echo "Tailscale refused the key (expired after 7 days?). tailscaled log:"
  tail -n 12 /var/log/tailscaled.log 2>/dev/null | sed -E 's/tskey-[A-Za-z0-9-]+/tskey-***/g'
fi
tsip=$(ts ip -4 2>/dev/null | head -1)
echo; echo "================= give these to Claude ================="
echo "Tailscale IP : ${tsip:-<not connected>}"; echo "LAN IP(s)    :"; lanips
echo "ssh          : key-only (root@<ip>)   hostname: $HOST"; echo "========================================================="
[ -n "$tsip" ]
