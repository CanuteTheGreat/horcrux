#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# hogsmeade-remote: LAN reachability helper (live USB AND the installed system). Tailscale is retired: the handoff is plain key-only ssh over the
# home LAN (DHCP name hogsmeade.home.canutethegreat.com via kingscross) and, if needed, the WireGuard network (ctg-infrastructure network/wireguard).
# The agent's public key is baked into the PRIVATE image only (sys-apps/hogsmeade-private -> /root/.ssh/authorized_keys). Needs a network first.
set -u
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
LIVE=0; [ -d /run/initramfs/live ] || grep -q -E 'rd.live|root=live' /proc/cmdline 2>/dev/null && LIVE=1
if [ $LIVE = 1 ]; then HOST=hogsmeade-live; else HOST=hogsmeade; fi
lanips() { ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); print "  " a[1] "  (" $2 ")"}'; }
echo "== network"
if ! ip -4 route show default | grep -q .; then
  echo "No default route: the laptop is not online yet."
  echo "  Wi-Fi: nmtui (Activate a connection)     Ethernet: plug it in, DHCP is automatic"; exit 1; fi
ip -4 route show default | head -2
echo "== sshd (key-only)"
rc-service sshd status >/dev/null 2>&1 || rc-service sshd start >/dev/null 2>&1; rc-service sshd status 2>&1 | tail -1
echo "== clock"
# a live stick can boot with a clock months off (TLS fails). A plain-HTTP Date header needs no certificate.
d=$(curl -sI -m 8 http://www.google.com 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | head -1)
if [ -n "$d" ] && date -u -s "$d" >/dev/null 2>&1; then hwclock -w -u 2>/dev/null; echo "clock set to: $(date -u)"; else echo "clock left as: $(date -u)"; fi
hostname "$HOST" 2>/dev/null
echo
echo "================= give these to Claude ================="
echo "LAN IP(s)    :"; lanips
echo "ssh          : key-only (root@<ip>)   hostname: $HOST   (LAN name: hogsmeade.home.canutethegreat.com)"
echo "========================================================="
ip -4 route show default | grep -q . && rc-service sshd status >/dev/null 2>&1
