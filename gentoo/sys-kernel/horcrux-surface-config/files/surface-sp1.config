# Horcrux Surface Pro 1/2 (Ivy Bridge tablet, 4 GB): what the 2013 hardware needs on top of Gentoo's dist-kernel config.
# Merged by the dist-kernel eclass (/etc/kernel/config.d) after the linux-surface fragment.
# touch + Wacom pen (USB-HID), Type Cover
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_WACOM=m
CONFIG_USB_HID=y
CONFIG_USB_XHCI_PCI=y
# accelerometer / ambient light / compass (screen rotation) via the HID sensor hub
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_IIO_TRIGGER=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_MAGNETOMETER_3D=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SENSOR_DEVICE_ROTATION=m
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=m
# Marvell AVASTAR 88W8797 Wi-Fi/Bluetooth: SDIO, USB and PCIe transports (the real bus is only known on the device)
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_SDIO=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_MWIFIEX_USB=m
CONFIG_BT_MRVL=m
CONFIG_BT_MRVL_SDIO=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
# graphics, disk encryption, swap/hibernate, file systems
CONFIG_DRM_I915=m
CONFIG_DM_CRYPT=m
CONFIG_DM_MOD=y
CONFIG_BLK_DEV_DM=y
CONFIG_XFS_FS=y
CONFIG_HIBERNATION=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ACPI_BUTTON=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP_FILTER=y
