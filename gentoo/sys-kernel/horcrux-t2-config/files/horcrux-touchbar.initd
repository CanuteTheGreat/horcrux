#!/sbin/openrc-run
# Attach the Apple T2 Touch Bar display to appletbdrm so tiny-dfr can draw on it. The logic is /usr/libexec/horcrux-touchbar (shared with
# the systemd unit): USB configuration 2 + port reset + appletbdrm bind, see the script for why.
description="Touch Bar display attach (USB configuration 2 + reset + appletbdrm)"

depend() {
	need localmount udev
	after modules
	before tiny-dfr
}

start() {
	/usr/libexec/horcrux-touchbar || { eerror "Touch Bar attach failed (see above)"; return 1; }
}

stop() {
	# nothing to undo: leaving configuration 2 selected is harmless, the next boot starts in configuration 1
	return 0
}
