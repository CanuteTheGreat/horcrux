# HOGSMEADE (Alienware 18 Area-51 AA18250, Arrow Lake-HX + RTX 5090 Laptop): kernel config fragment merged by the
# dist-kernel eclass AFTER Gentoo's config (/etc/kernel/config.d). Every line is verified against the final .config
# by the image build (required-config.txt).
# --- storage: the three NVMe drives sit behind Intel VMD until the owner switches the BIOS to AHCI. Keep the VMD
# --- driver in the kernel (=y) so the machine boots in BOTH modes; NVMe built in so the pool is visible early.
CONFIG_VMD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_SATA_AHCI=y
# --- SoundWire / SDCA audio: SOF on Arrow Lake (Meteor Lake generation PCI id) + Realtek RT722 jack codec + RT1320 amps
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SND_SOC_SDCA=m
CONFIG_SND_SOC_RT722_SDCA_SDW=m
CONFIG_SND_SOC_RT1320_SDW=m
CONFIG_SND_HDA_INTEL=m
# --- network: Killer BE1750w = Intel BE200 (iwlwifi, MLD op-mode on new kernels), Killer E5000 = Realtek r8169 family, BT
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_R8169=m
CONFIG_BT_INTEL=m
CONFIG_BT_HCIBTUSB=m
# --- graphics: iGPU 8086:7D67 (xe and i915 both built; the NVIDIA open modules come from x11-drivers/nvidia-drivers)
CONFIG_DRM_XE=m
CONFIG_DRM_I915=m
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y
# --- platform: Alienware WMI (thermal/fans/G-Mode via platform_profile+hwmon), NVIDIA WMI-EC backlight, Dell DDV battery
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_DDV=m
CONFIG_DELL_WMI_SYSMAN=m
CONFIG_ALIENWARE_WMI=m
CONFIG_ALIENWARE_WMI_WMAX=y
CONFIG_NVIDIA_WMI_EC_BACKLIGHT=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_ACPI_VIDEO=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_HWMON=y
# --- sensor hub (ISH), touchpad (I2C-HID behind Intel LPSS), lighting controller (hidraw for the AlienFX daemon)
CONFIG_INTEL_ISH_HID=m
CONFIG_INTEL_ISH_FIRMWARE_DOWNLOADER=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HIDRAW=y
CONFIG_USB_HID=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX_PCI=m
# --- Thunderbolt 5 / USB4, TPM (PTT), webcam, Bluetooth, NPU (optional)
CONFIG_USB4=m
CONFIG_TCG_TPM=y
CONFIG_TCG_CRB=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_DRM_ACCEL_IVPU=m
# --- hibernate (resume from the LUKS swap) + encrypted ZFS root + zram
CONFIG_HIBERNATION=y
CONFIG_DM_CRYPT=m
CONFIG_ZRAM=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_TUN=m
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_RAPL=m
CONFIG_INTEL_POWERCLAMP=m
