#!/bin/sh
# NetworkManager dispatcher hook (Horcrux): give chrony its sources as soon as a network is up.
#
# chronyd starts in the default runlevel before the Wi-Fi/DHCP link exists, so its `pool` name cannot be
# resolved and it ends up with ZERO sources (it does not retry on its own while it believes it is offline).
# A laptop then keeps its boot-time clock, which breaks TLS, Tailscale and emerge. On every link-up this
# hook tells chronyd the network is there, re-resolves the pool/server names and asks for a quick burst.
#
# $1 = interface, $2 = action (see NetworkManager-dispatcher(8))
case "$2" in
	up|dhcp4-change|dhcp6-change|connectivity-change) ;;
	*) exit 0 ;;
esac
case "$1" in
	lo|tailscale*|docker*|virbr*|veth*|br-*) exit 0 ;;
esac
command -v chronyc >/dev/null 2>&1 || exit 0
# chronyd not running (or still starting): nothing to tell, it will resolve by itself
chronyc -n tracking >/dev/null 2>&1 || exit 0
# background so a slow chronyd can never delay NetworkManager's other hooks
(
	chronyc -n online
	chronyc -n reload sources
	chronyc -n burst 4/4
) >/dev/null 2>&1 &
exit 0
