#!/bin/bash
# Push the GNOME session environment into the user D-Bus session bus's ACTIVATION environment (what gnome-session does under systemd with
# `systemctl --user import-environment` + `dbus-update-activation-environment --systemd`).
#
# Why: on OpenRC the user's dbus-daemon is a user service started BEFORE gnome-shell, so everything it D-Bus-activates (GNOME Settings, Nautilus, Text
# Editor, the portals, ...) inherits a bare environment: no XDG_CURRENT_DESKTOP, WAYLAND_DISPLAY, XDG_DATA_DIRS, ... GNOME Settings then exits with
# "Running gnome-control-center is only supported under GNOME and Unity" and never opens (HOGSMEADE, 2026-11-11).
#
# Runs as an XDG autostart entry (gnome-session-openrc starts those only after gnome-shell is up), once per login. Values come from this process's
# environment, falling back to the running gnome-shell's (which imported the gdm session leader's environment) and to the live sockets. Only an explicit
# list is exported, never the whole environment. If xdg-desktop-portal was started before the update (it picks its backend from XDG_CURRENT_DESKTOP) it
# is restarted so the next D-Bus activation builds it with the right environment.
#   horcrux-session-env            update the activation environment
#   horcrux-session-env --print    only print NAME=value lines that would be pushed (test / diagnosis, changes nothing)
# Test hooks: HX_PROC (default /proc), HX_UPDATE_CMD (default dbus-update-activation-environment), HX_NO_PORTAL=1.
VARS="XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION XDG_SESSION_CLASS XDG_SESSION_ID XDG_MENU_PREFIX XDG_DATA_DIRS XDG_CONFIG_DIRS GNOME_SETUP_DISPLAY WAYLAND_DISPLAY DISPLAY XAUTHORITY"
PROC="${HX_PROC:-/proc}"
UPDATE="${HX_UPDATE_CMD:-dbus-update-activation-environment}"
UIDN="${HX_UID:-$(id -u)}"
RT="${XDG_RUNTIME_DIR:-/run/user/$UIDN}"

# the shell: wayland and x11 variants are both /usr/bin/gnome-shell; the pidfile names differ per OpenRC service
shell_pid() {
	local f p
	for f in "$RT"/gnome-shell-wayland.pid "$RT"/gnome-shell-x11.pid "$RT"/gnome-shell.pid; do
		p=$(cat "$f" 2>/dev/null) || continue
		[ -r "$PROC/$p/environ" ] && { echo "$p"; return; }
	done
	pgrep -u "$UIDN" -x gnome-shell 2>/dev/null | head -n1
}
SP=$(shell_pid)
shell_env() {	# value of $1 in the shell's initial environment
	[ -n "$SP" ] && tr '\0' '\n' < "$PROC/$SP/environ" 2>/dev/null | sed -n "s/^$1=//p" | head -n1
}

OUT=()
for v in $VARS; do
	val="${!v}"
	[ -n "$val" ] || val=$(shell_env "$v")
	if [ -z "$val" ]; then
		case "$v" in
		WAYLAND_DISPLAY) s=$(ls "$RT"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1); [ -n "$s" ] && val=${s##*/} ;;
		DISPLAY) s=$(ls /tmp/.X11-unix/X[0-9]* 2>/dev/null | head -n1); [ -n "$s" ] && val=":${s##*/X}" ;;
		esac
	fi
	[ -n "$val" ] && OUT+=("$v=$val")
done
# a session that gives neither a desktop name nor anything to derive it from is not a GNOME session
printf '%s\n' "${OUT[@]}" | grep -q '^XDG_CURRENT_DESKTOP=' || OUT+=("XDG_CURRENT_DESKTOP=GNOME")

if [ "$1" = "--print" ]; then
	printf '%s\n' "${OUT[@]}"
	exit 0
fi

# the user bus of the OpenRC session, never gdm's private one that the session leader's environment may name
[ -S "$RT/bus" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$RT/bus"
"$UPDATE" "${OUT[@]}" || { echo "horcrux-session-env: $UPDATE failed" >&2; exit 1; }

[ -n "$HX_NO_PORTAL" ] && exit 0
pp=$(pgrep -u "$UIDN" -x xdg-desktop-portal 2>/dev/null | head -n1)
if [ -n "$pp" ] && ! tr '\0' '\n' < "$PROC/$pp/environ" 2>/dev/null | grep -q '^XDG_CURRENT_DESKTOP='; then
	if rc-service -U xdg-desktop-portal status >/dev/null 2>&1; then
		rc-service -U xdg-desktop-portal restart >/dev/null 2>&1
	else
		kill "$pp" 2>/dev/null	# D-Bus-activated: the next request starts it again with the updated environment
	fi
fi
exit 0
