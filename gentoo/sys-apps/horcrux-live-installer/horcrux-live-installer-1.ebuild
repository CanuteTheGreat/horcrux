EAPI=8

DESCRIPTION="Horcrux live-ISO installer, boot/rescue sessions, console menu and branding (scripts + init services)"
HOMEPAGE="https://git.canutethegreat.com/CanuteTheGreat/horcrux"
# The distfile is made by build/live-iso (variants/surface/Dockerfile) from the repository tree at image-build time:
# common/overlay + project/overlay, nothing downloaded. A machine that does not have it cannot rebuild this package, which
# is the point: the files belong to THIS image's installer and are updated by building a new image.
SRC_URI="${P}.tar.zst"

LICENSE="GPL-2"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="fetch mirror bindist"

BDEPEND="app-arch/zstd"

pkg_nofetch() {
	einfo "${SRC_URI} is generated by build/live-iso/project/variants/surface/Dockerfile (tar of common/overlay + project/overlay)."
}

src_unpack() {
	mkdir -p "${S}" || die
	tar -C "${S}" --zstd -xf "${DISTDIR}/${SRC_URI}" || die
}

src_install() {
	cp -a "${S}/." "${ED}/" || die
}
