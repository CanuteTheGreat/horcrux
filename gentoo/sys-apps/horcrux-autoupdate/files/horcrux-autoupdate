#!/usr/bin/python3
"""horcrux-autoupdate: keep a Horcrux install up to date through Portage. Never reboots.

  horcrux-autoupdate cron     run when due (>= INTERVAL_HOURS since the last attempt); what cron / the systemd timer call hourly
  horcrux-autoupdate run      run now (ignores the interval)
  horcrux-autoupdate status   print the last result (--json for status.json)
  horcrux-autoupdate check    exit 0 ok / 1 warning / 2 critical, one line of text: for health checks and monitoring agents
  horcrux-autoupdate pending  list the world updates still pending
  horcrux-autoupdate restart-services [--now]  restart a Horcrux service whose program an update replaced (guests keep running)

One run: lock, `emaint sync -a`, boot-environment snapshot (ZFS root), `emerge --update --changed-use --newuse --deep @world` (--with-bdeps=y, the default; WITH_BDEPS=no selects --with-bdeps=n; CHANGED_USE=no drops --changed-use) (binary packages from the
binhost preferred, source build as the fallback), a guarded `emerge --depclean`, `@preserved-rebuild`, `etc-update --preen`. Low CPU and I/O priority.
After the update, a Horcrux service whose program was replaced (horcrux-api) is restarted so the new code runs; its guests keep running,
and it waits while a client is connected (checked again hourly). Results land in STATE_DIR (status.json, failed, reboot-required) and LOG_DIR (one log per run). A new kernel, microcode or other package that
needs a reboot is recorded in `reboot-required` (also /run/reboot-required); nothing is rebooted and nothing pops up.
Policy and knobs: /etc/horcrux/autoupdate.conf (docs/design/autoupdate.md in the repository).
"""
import argparse
import fnmatch
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

VERSION = "1"
CONF = os.environ.get("HX_AU_CONF", "/etc/horcrux/autoupdate.conf")
STATE_DIR = os.environ.get("HX_AU_STATE", "/var/lib/horcrux-autoupdate")
LOG_DIR = os.environ.get("HX_AU_LOG", "/var/log/horcrux-autoupdate")
LOCK = os.environ.get("HX_AU_LOCK", "/run/lock/horcrux-autoupdate.lock")
EMERGE_LOG = os.environ.get("HX_AU_EMERGE_LOG", "/var/log/emerge.log")
PRESERVED = os.environ.get("HX_AU_PRESERVED", "/var/lib/portage/preserved_libs_registry")
RUN_REBOOT_FLAG = os.environ.get("HX_AU_RUN_FLAG", "/run/reboot-required")
GENTOO_REPO = os.environ.get("HX_AU_GENTOO_REPO", "")  # empty: ask portageq, else /var/db/repos/gentoo
SLEEP = time.sleep

# Binary-package managers: Portage matches a binary package by version, and these ebuilds install a tarball fetched at unpack time, so a
# binary package would silently reinstall an older tarball (same list as horcrux-api's PREBUILT_PACKAGES).
PREBUILT = ["app-emulation/horcrux-bin"]

DEFAULTS = {
    "ENABLED": "yes",
    "INTERVAL_HOURS": "24",       # one attempt per this many hours; the hourly trigger makes a machine that was off at night catch up
    "SYNC": "yes",
    "SYNC_RETRIES": "2",          # a repository whose sync failed is synced again on its own this many times (another rsync mirror)
    "SYNC_RETRY_DELAY": "120",    # seconds before each retry
    "SYNC_MAX_AGE_HOURS": "48",   # the gentoo tree must be at most this old after the sync step (metadata/timestamp.chk)
    "SNAPSHOT": "yes",            # boot-environment / ZFS snapshot before the update (ZFS root only)
    "DEPCLEAN": "safe",           # safe | no. safe = only when `--pretend` shows no protected package and no more than DEPCLEAN_MAX removals
    "DEPCLEAN_MAX": "20",
    "WITH_BDEPS": "yes",          # yes (default): exactly `emerge -uUND --with-bdeps=y @world` on every Horcrux install, desktop and server: build dependencies of
                                  # installed packages are kept updated too. A host that must not carry them sets WITH_BDEPS=no itself (never changed for it here).
                                  # On a headless server the first run therefore also merges build-only packages (compilers, headers, X11 libraries);
                                  # depclean uses the same switch, so it never offers them for removal while WITH_BDEPS=yes.
    "CHANGED_USE": "yes",         # yes (default): --changed-use, so a USE change on an installed package is picked up (the -U of `-uUND`)
    "DEPCLEAN_KEEP": "sys-kernel/* sys-fs/zfs-kmod sys-fs/zfs sys-boot/* x11-drivers/nvidia-drivers sys-firmware/* app-emulation/horcrux* sys-apps/horcrux*",
    "PRESERVED_REBUILD": "yes",
    "ETC_UPDATE": "preen",        # preen (trivial changes only) | all (--automode -5: replaces edited files) | off
    "SKIP_ON_BATTERY": "yes",
    "STALE_DAYS": "3",            # `check` warns after this many days without a successful run, critical after twice that
    "MAX_RUNTIME_HOURS": "12",
    "EXTRA_EMERGE_OPTS": "",
    "RESTART_SERVICES_ENABLED": "yes",  # restart the services below once an update replaced their program (guests keep running)
    "RESTART_SERVICES": "horcrux-ha-fence horcrux-api",  # in this order
    "RESTART_PROGRAMS": "/usr/bin/horcrux-api",  # what counts as the service's own program (everything else in its cgroup = its guests)
    "RESTART_IDLE": "yes",        # yes: wait while a client (web UI, API, console viewer) is connected; the hourly trigger retries
    "RESTART_WAIT_SECS": "90",    # how long the restarted service may take to run again
    "REBOOT_PACKAGES": "sys-kernel/gentoo-kernel sys-kernel/gentoo-kernel-bin sys-kernel/vanilla-kernel sys-kernel/vanilla-kernel-bin "
                       "sys-kernel/linux-firmware sys-firmware/intel-microcode sys-fs/zfs-kmod x11-drivers/nvidia-drivers sys-apps/systemd",
}


def read_conf(path=None):
    path = path or CONF
    c = dict(DEFAULTS)
    try:
        with open(path) as f:
            for ln in f:
                ln = ln.strip()
                if not ln or ln.startswith("#") or "=" not in ln:
                    continue
                k, _, v = ln.partition("=")
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                c[k.strip()] = v
    except OSError:
        pass
    return c


def yes(v):
    return str(v).strip().lower() in ("1", "yes", "true", "on")


def now():
    return int(time.time())


def iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(t))


# ---------------------------------------------------------------- state files

def state_path(name):
    return os.path.join(STATE_DIR, name)


def read_status():
    try:
        with open(state_path("status.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_atomic(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_status(st):
    write_atomic(state_path("status.json"), json.dumps(st, indent=2, sort_keys=True) + "\n")
    failed = state_path("failed")
    if st.get("result") == "failed":
        write_atomic(failed, f"{iso(st.get('finished', now()))} step={st.get('failed_step', '?')} {st.get('error', '')}\n")
    elif st.get("result") in ("ok", "disabled"):
        try:
            os.unlink(failed)
        except OSError:
            pass


def boot_time():
    try:
        with open("/proc/stat") as f:
            for ln in f:
                if ln.startswith("btime "):
                    return int(ln.split()[1])
    except OSError:
        pass
    return 0


def reboot_state():
    """(needed, reasons). The marker belongs to the boot it was written in: a later boot clears it."""
    p = state_path("reboot-required")
    try:
        mt = os.path.getmtime(p)
    except OSError:
        return False, []
    if mt < boot_time():
        for f in (p, RUN_REBOOT_FLAG):
            try:
                os.unlink(f)
            except OSError:
                pass
        return False, []
    with open(p) as f:
        return True, [ln.strip() for ln in f if ln.strip()]


def add_reboot_reasons(reasons):
    old = reboot_state()[1]
    allr = old + [r for r in reasons if r not in old]
    if not allr:
        return
    write_atomic(state_path("reboot-required"), "\n".join(allr) + "\n")
    try:
        write_atomic(RUN_REBOOT_FLAG, "*** System restart required ***\n")
    except OSError:
        pass


# ---------------------------------------------------------------- helpers

def sh(argv, log=None, timeout=None, env=None, full=False):
    """run argv, stream output to the log file object; returns (rc, last 25 lines of output, or all of them with full=True)"""
    tail = []
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", env=env)
    except OSError as e:
        if log:
            log.write(f"cannot run {argv[0]}: {e}\n")
        return 127, [str(e)]
    deadline = time.time() + timeout if timeout else None
    for ln in p.stdout:
        if log:
            log.write(ln)
            log.flush()
        tail.append(ln.rstrip())
        if not full:
            del tail[:-25]
        if deadline and time.time() > deadline:
            p.kill()
            tail.append("killed: maximum runtime exceeded")
            break
    return p.wait(), tail


def prio(argv):
    pre = []
    if shutil.which("nice"):
        pre += ["nice", "-n", "19"]
    if shutil.which("ionice"):
        pre += ["ionice", "-c", "3"]
    return pre + argv


def emerge_opts(conf):
    o = ["--ask=n", "--color=n", "--nospinner", "--quiet-build=y", "--getbinpkg", "--usepkg"]
    o += [f"--usepkg-exclude={p}" for p in PREBUILT]
    o += conf.get("EXTRA_EMERGE_OPTS", "").split()
    return o


def bdeps_opt(conf):
    return "--with-bdeps=y" if yes(conf.get("WITH_BDEPS", "yes")) else "--with-bdeps=n"


def resolve_opts(conf):
    """the world resolution options: --update --changed-use --newuse --deep --with-bdeps=y (each switch is a conf key)"""
    o = ["--update"]
    if yes(conf.get("CHANGED_USE", "yes")):
        o.append("--changed-use")
    return o + ["--newuse", "--deep", bdeps_opt(conf)]


def world_args(conf):
    return emerge_opts(conf) + resolve_opts(conf) + ["--keep-going", "@world"]


def on_battery():
    bat = ac = False
    for ps in glob.glob("/sys/class/power_supply/*"):
        try:
            t = open(os.path.join(ps, "type")).read().strip()
            if t == "Battery":
                bat = True
            elif t == "Mains" and open(os.path.join(ps, "online")).read().strip() == "1":
                ac = True
        except OSError:
            pass
    return bat and not ac


def other_emerge_running():
    me = os.getpid()
    for d in glob.glob("/proc/[0-9]*"):
        try:
            if int(os.path.basename(d)) == me:
                continue
            cmd = open(os.path.join(d, "cmdline"), "rb").read().split(b"\0")
        except (OSError, ValueError):
            continue
        if not cmd or not cmd[0]:
            continue
        exe = os.path.basename(cmd[0].decode(errors="replace"))
        if exe in ("emerge",) or (exe.startswith("python") and len(cmd) > 1 and os.path.basename(cmd[1].decode(errors="replace")) == "emerge"):
            return True
    return False


# ---------------------------------------------------------------- restarting replaced services
#
# A package upgrade replaces /usr/bin/horcrux-api on disk, but the running manager keeps executing the old (now deleted) file until it
# is restarted, so an installed fix is not running. After an update, every service in RESTART_SERVICES whose own program was replaced is
# restarted. That never ends a guest: QEMU and the container runtimes are not the manager's processes to kill (OpenRC script and systemd
# unit, KillMode=process), and dependents are left alone (OpenRC --nodeps; the guests unit only Wants= the manager). A restart waits
# while somebody uses the manager (an open web UI, API or console connection) or a guest power pass runs; it is retried by the hourly
# trigger and shown in `status`/`check` until it happened. Nothing pops up, nothing reboots.

PROC = os.environ.get("HX_AU_PROC", "/proc")
CGROUP = os.environ.get("HX_AU_CGROUP", "/sys/fs/cgroup")


def init_system():
    return "systemd" if os.path.isdir("/run/systemd/system") else "openrc"


def service_cgroup(svc):
    """the cgroup v2 directory of a service, or None (cgroup v1 hosts, service not running)"""
    for rel in (f"openrc.{svc}", f"system.slice/{svc}.service"):
        p = os.path.join(CGROUP, rel)
        if os.path.exists(os.path.join(p, "cgroup.procs")):
            return p
    return None


def cgroup_pids(cg):
    try:
        with open(os.path.join(cg, "cgroup.procs")) as f:
            return [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        return []


def proc_exe(pid):
    """(path, replaced): the program a process runs and whether that file was replaced or removed since it started"""
    try:
        exe = os.readlink(os.path.join(PROC, str(pid), "exe"))
    except OSError:
        return None, False
    if exe.endswith(" (deleted)"):
        return exe[:-len(" (deleted)")], True
    return exe, False


def service_procs(svc, programs):
    """(program pids, other pids) of a running service: its own program vs. what it started (guests)"""
    cg = service_cgroup(svc)
    if not cg:
        return [], []
    own, other = [], []
    for pid in cgroup_pids(cg):
        path, _ = proc_exe(pid)
        (own if path in programs else other).append(pid)
    return own, other


def socket_inodes(pid):
    out = set()
    for fd in glob.glob(os.path.join(PROC, str(pid), "fd", "*")):
        try:
            t = os.readlink(fd)
        except OSError:
            continue
        if t.startswith("socket:["):
            out.add(t[8:-1])
    return out


def client_connections(pid):
    """open client connections to a process's own listening sockets: TCP (web UI, API, console relay) and unix (local viewers)"""
    inodes = socket_inodes(pid)
    if not inodes:
        return 0
    n = 0
    for name in ("tcp", "tcp6"):
        listen, est = set(), []
        try:
            with open(os.path.join(PROC, str(pid), "net", name)) as f:
                next(f, None)
                for ln in f:
                    p = ln.split()
                    if len(p) < 10 or p[9] not in inodes:
                        continue
                    port = p[1].rsplit(":", 1)[-1]
                    if p[3] == "0A":
                        listen.add(port)
                    elif p[3] == "01":
                        est.append((p[1], p[2]))
        except OSError:
            continue
        mine = set(est)
        # a connection the process made to itself (its own loopback client) has both ends here: not a user
        n += sum(1 for loc, rem in est if loc.rsplit(":", 1)[-1] in listen and (rem, loc) not in mine)
    try:
        with open(os.path.join(PROC, str(pid), "net", "unix")) as f:
            next(f, None)
            rows = [ln.split() for ln in f]
        mine = [r for r in rows if len(r) >= 7 and r[6] in inodes]
        listening = {r[7] for r in mine if len(r) >= 8 and int(r[3], 16) & 0x10000}
        n += sum(1 for r in mine if len(r) >= 8 and r[5] == "03" and r[7] in listening and not int(r[3], 16) & 0x10000)
    except (OSError, ValueError):
        pass
    return n


def guest_power_pass_running():
    """a `horcrux-api guests boot|stop` pass (it talks to the manager)"""
    for d in glob.glob(os.path.join(PROC, "[0-9]*")):
        try:
            cmd = open(os.path.join(d, "cmdline"), "rb").read().split(b"\0")
        except OSError:
            continue
        if len(cmd) > 1 and os.path.basename(cmd[0].decode(errors="replace")) == "horcrux-api" and cmd[1] == b"guests":
            return True
    return False


def alive(pid):
    return os.path.exists(os.path.join(PROC, str(pid)))


RC_CONF = os.environ.get("HX_AU_RC_CONF", "/etc/rc.conf")


def guests_survive_restart(svc, init=None, runner=None):
    """None when stopping the service leaves the processes it started running, else the reason it would not"""
    runner = runner or sh
    if (init or init_system()) == "systemd":
        rc, out = runner(["systemctl", "show", "-p", "KillMode", "--value", f"{svc}.service"], None)
        mode = (out[-1] if out else "").strip()
        if rc != 0 or mode not in ("process", "none"):
            return f"{svc}.service has KillMode={mode or '?'}: a restart would end the guests it started"
        return None
    for path in (RC_CONF, f"/etc/conf.d/{svc}"):
        try:
            for ln in open(path):
                k, _, v = ln.strip().partition("=")
                if k.strip() == "rc_cgroup_cleanup" and yes(v.strip().strip("\"'")):
                    return f"rc_cgroup_cleanup is on in {path}: stopping {svc} would end the guests it started"
        except OSError:
            pass
    return None


def restart_argv(svc, init=None):
    if (init or init_system()) == "systemd":
        return ["systemctl", "restart", f"{svc}.service"]
    # --nodeps: services that `use` the manager (horcrux-guests) are not stopped with it
    return [f"/etc/init.d/{svc}", "--nodeps", "restart"]


def restart_replaced(conf, log=None, runner=None, force=False, wait=None):
    """restart every RESTART_SERVICES service whose own program was replaced. Returns (summary, pending reason or None)"""
    runner = runner or sh
    if not yes(conf["RESTART_SERVICES_ENABLED"]):
        return "disabled", None
    programs = set(conf["RESTART_PROGRAMS"].split())
    wait = int(conf["RESTART_WAIT_SECS"]) if wait is None else wait
    stale = []
    for svc in conf["RESTART_SERVICES"].split():
        own, other = service_procs(svc, programs)
        if any(proc_exe(p)[1] for p in own):
            stale.append((svc, own, other))
    if not stale:
        return "nothing to restart", None
    names = " ".join(s for s, _, _ in stale)
    if not force:
        if guest_power_pass_running():
            return f"waiting: {names} (a guest power pass is running)", "a guest power pass is running"
        if yes(conf["RESTART_IDLE"]):
            busy = sum(client_connections(p) for _, own, _ in stale for p in own)
            if busy:
                why = f"{busy} open client connection(s) to the manager (web UI, API or console)"
                return f"waiting: {names} ({why})", why
    done, failed = [], []
    for svc, own, other in stale:
        unsafe = guests_survive_restart(svc, runner=runner) if other else None
        if unsafe:
            failed.append(f"{svc} not restarted: {unsafe}")
            continue
        if log:
            log.write(f"restart {svc}: its program was replaced by the update (pids {own}); {len(other)} guest process(es) keep running\n")
        rc, tail = runner(restart_argv(svc), log, timeout=wait + 60)
        new = []
        deadline = time.time() + wait
        while time.time() < deadline:
            new, _ = service_procs(svc, programs)
            if new and not any(proc_exe(p)[1] for p in new) and not set(new) & set(own):
                break
            SLEEP(1)
        lost = [p for p in other if not alive(p)]
        ok = rc == 0 and new and not any(proc_exe(p)[1] for p in new)
        if lost and log:
            log.write(f"restart {svc}: processes gone after the restart: {lost}\n")
        if ok:
            done.append(f"{svc} (guests kept {len(other) - len(lost)}/{len(other)})")
        else:
            failed.append(f"{svc} rc={rc}: {' | '.join(tail[-2:])}")
    if failed:
        return "restart failed: " + "; ".join(failed), "restart failed: " + "; ".join(failed)
    return "restarted " + ", ".join(done), None


def record_restart(summary, pending):
    p = state_path("restart-pending")
    if pending:
        since = None
        try:
            with open(p) as f:
                since = int(f.readline().split()[0])
        except (OSError, ValueError, IndexError):
            pass
        write_atomic(p, f"{since or now()} {pending}\n")
    else:
        try:
            os.unlink(p)
        except OSError:
            pass


def restart_pending():
    """(since, reason) or (None, None)"""
    try:
        with open(state_path("restart-pending")) as f:
            t, _, why = f.readline().strip().partition(" ")
            return int(t), why
    except (OSError, ValueError):
        return None, None


def root_zfs():
    try:
        for ln in open("/proc/mounts"):
            f = ln.split()
            if len(f) >= 3 and f[1] == "/" and f[2] == "zfs":
                return f[0]
    except OSError:
        pass
    return None


def atom_of(cpv):
    m = re.match(r"^(.*?)-[0-9][0-9A-Za-z._+]*(-r[0-9]+)?$", cpv)
    return m.group(1) if m else cpv


def merged_since(offset, path=None):
    """category/package names whose merge completed in emerge.log after byte `offset`"""
    path = path or EMERGE_LOG
    out = []
    try:
        with open(path, errors="replace") as f:
            f.seek(offset)
            for ln in f:
                m = re.search(r"::: completed emerge \(\d+ of \d+\) (\S+) to ", ln)
                if m:
                    out.append(atom_of(m.group(1)))
    except OSError:
        pass
    return out


def size_of(path):
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def newest_installed_kernel():
    vs = []
    for d in glob.glob("/lib/modules/*"):
        v = os.path.basename(d)
        if re.match(r"^\d", v) and (os.path.isdir(os.path.join(d, "kernel")) or os.path.exists(os.path.join(d, "modules.dep"))):
            vs.append(v)
    if not vs:
        return None

    def key(v):
        return [int(x) if x.isdigit() else x for x in re.split(r"[.\-+_]", v)]
    try:
        return sorted(vs, key=key)[-1]
    except TypeError:
        return sorted(vs)[-1]


def reboot_reasons(merged, conf, running=None, newest=None):
    reasons = []
    running = running or os.uname().release
    newest = newest if newest is not None else newest_installed_kernel()
    if newest and newest != running:
        reasons.append(f"kernel {running} is running, {newest} is installed")
    pats = conf.get("REBOOT_PACKAGES", "").split()
    seen = []
    for a in merged:
        if a not in seen and any(fnmatch.fnmatchcase(a, p) for p in pats):
            seen.append(a)
    reasons += [f"{a} updated" for a in seen]
    return reasons


def parse_depclean(text):
    """packages `emerge --depclean --pretend` would remove: the 'All selected packages: a/b-1 c/d-2' line (and its continuation lines)"""
    out = []
    on = False
    for ln in text.splitlines():
        s = ln.strip()
        if s.startswith("All selected packages:"):
            on = True
            s = s.split(":", 1)[1].strip()
        elif not on:
            continue
        elif not s or s.startswith(">>>") or s.startswith("Packages installed"):
            break
        out += [atom_of(t.lstrip("=")) for t in s.split() if re.match(r"^=?[a-z0-9+_.-]+/\S+-[0-9]", t)]  # newer Portage prints =cat/pkg-ver
    return out


def parse_pending(text):
    return [ln.strip() for ln in text.splitlines() if re.match(r"^\[(ebuild|binary)\s", ln.strip())]


def depclean_plan(atoms, conf):
    """(remove, kept, why_not). Protected packages (old kernels, ZFS, boot, firmware, Horcrux) are left out of the removal instead of
    blocking it; the rest is removed by name when it is no more than DEPCLEAN_MAX (a bigger set usually means a broken world file)."""
    keep = conf.get("DEPCLEAN_KEEP", "").split()
    remove, kept = [], []
    for a in atoms:
        (kept if any(fnmatch.fnmatchcase(a, p) for p in keep) else remove).append(a)
    remove = list(dict.fromkeys(remove))
    if len(remove) > int(conf.get("DEPCLEAN_MAX", "20") or 20):
        return remove, kept, f"would remove {len(remove)} packages (limit {conf.get('DEPCLEAN_MAX')})"
    return remove, kept, None


# ---------------------------------------------------------------- sync

SYNC_ACTION = re.compile(r"^Action: sync for repo: (\S+), returned code = (-?\d+)")
SYNC_ERROR = re.compile(r"(!!!|Manifest mismatch|rsync error|rsync: |fatal: |error: |timed out|returned code = [1-9])", re.I)


def parse_sync(lines):
    """{repo: return code} from `emaint sync` output (one 'Action: sync for repo: X, returned code = N' line per repository)"""
    codes = {}
    for ln in lines:
        m = SYNC_ACTION.match(ln.strip())
        if m:
            codes[m.group(1)] = int(m.group(2))
    return codes


def sync_errors(lines, limit=3):
    """the lines that say why a sync failed ('!!! Manifest verification failed', 'Manifest mismatch for ...'), without the Action summary"""
    out = []
    for ln in lines:
        s = ln.strip()
        if s and SYNC_ERROR.search(s) and not SYNC_ACTION.match(s) and "cannot properly execute" not in s and s not in out:
            out.append(s[:160])
    return out[:limit]


def gentoo_repo_path():
    if GENTOO_REPO:
        return GENTOO_REPO
    try:
        p = subprocess.run(["portageq", "get_repo_path", "/", "gentoo"], capture_output=True, text=True, timeout=60).stdout.strip()
        if p:
            return p
    except (OSError, subprocess.SubprocessError):
        pass
    return "/var/db/repos/gentoo"


def tree_age_hours(path):
    """age of the gentoo tree from metadata/timestamp.chk ('Tue, 17 Nov 2026 14:45:00 +0000'); None when there is no such file"""
    import email.utils
    try:
        with open(os.path.join(path, "metadata", "timestamp.chk")) as f:
            t = email.utils.parsedate_to_datetime(f.read().strip())
    except (OSError, TypeError, ValueError, IndexError):
        return None
    return (now() - t.timestamp()) / 3600


def do_sync(conf, log, runner):
    """`emaint sync -a`, then each failed repository again on its own (a fresh rsync mirror: a mirror caught mid-update serves a tree
    whose Manifest does not verify, and Portage then keeps the old tree). Returns (ok, step detail, error, warnings).
    A non-zero exit with every repository at code 0 is a post-sync hook (eix-update and friends): a warning, provided the gentoo tree is
    fresh, not a failed sync."""
    rc, lines = runner(prio(["emaint", "sync", "-a"]), log, full=True)
    codes = parse_sync(lines)
    errs = {}
    failed = [r for r, c in codes.items() if c != 0]
    for r in failed:
        errs[r] = sync_errors(lines)
    warnings, notes = [], []
    if rc != 0 and not codes:
        return False, rc, "emaint sync -a failed: " + " | ".join((sync_errors(lines) or lines)[-3:]), warnings
    retries = int(conf.get("SYNC_RETRIES", "2") or 0)
    for r in list(failed):
        for i in range(retries):
            log.write(f"horcrux-autoupdate: repository {r} failed to sync ({'; '.join(errs[r]) or 'no reason printed'}), "
                      f"retry {i + 1}/{retries} in {conf.get('SYNC_RETRY_DELAY')} s\n")
            log.flush()
            SLEEP(float(conf.get("SYNC_RETRY_DELAY", "120") or 0))
            rrc, rlines = runner(prio(["emaint", "sync", "-r", r]), log, full=True)
            rcode = parse_sync(rlines).get(r, rrc)
            if rcode == 0:
                notes.append(f"{r} synced on retry {i + 1} (first attempt: {'; '.join(errs[r]) or 'failed'})")
                failed.remove(r)
                break
            errs[r] = sync_errors(rlines) or errs[r]
    if failed:
        why = "; ".join(f"{r}: {' / '.join(errs[r]) or 'failed'}" for r in failed)
        return False, 1, f"repository sync failed after {retries} retries: {why}", warnings
    if rc != 0 and not notes:  # every repository returned 0 in the first pass, yet emaint failed: a post-sync hook
        warnings.append("emaint sync -a exited %d with every repository synced (a post-sync hook failed: %s)"
                        % (rc, " | ".join(sync_errors(lines)) or "see the log"))
    if "gentoo" in codes:
        age = tree_age_hours(gentoo_repo_path())
        limit = float(conf.get("SYNC_MAX_AGE_HOURS", "48") or 48)
        if age is not None and age > limit:
            return False, 1, f"gentoo tree is {age:.0f} h old after the sync (limit {limit:.0f} h): the sync did not bring a new tree", warnings
    detail = "ok" if not notes and not warnings else "ok: " + "; ".join(notes + warnings)
    return True, detail if detail != "ok" else 0, "", warnings


# ---------------------------------------------------------------- the run

class Locked(Exception):
    pass


def take_lock(path=None):
    import fcntl
    path = path or LOCK
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise Locked()
    return fd


def prune_logs(keep=14):
    logs = sorted(glob.glob(os.path.join(LOG_DIR, "run-*.log")))
    for p in logs[:-keep]:
        try:
            os.unlink(p)
        except OSError:
            pass


def snapshot(log, conf):
    """(ok, detail). ZFS root: a horcrux-be boot environment snapshot (pruned like every pre-upgrade snapshot), else a plain snapshot."""
    ds = root_zfs()
    if not ds or not yes(conf["SNAPSHOT"]):
        return True, "no ZFS root" if not ds else "disabled"
    name = time.strftime("pre-upgrade-%Y%m%d-%H%M%S")
    if shutil.which("horcrux-be"):
        rc, tail = sh(["horcrux-be", "snapshot", name], log)
        return rc == 0, f"horcrux-be snapshot {name}" if rc == 0 else "horcrux-be snapshot failed: " + " ".join(tail[-2:])
    snap = f"{ds}@autoupdate-{time.strftime('%Y%m%d-%H%M%S')}"
    rc, tail = sh(["zfs", "snapshot", snap], log)
    if rc == 0:
        old = subprocess.run(["zfs", "list", "-H", "-t", "snapshot", "-o", "name", "-s", "creation", "-d", "1", ds],
                             capture_output=True, text=True).stdout.split()
        mine = [s for s in old if "@autoupdate-" in s]
        for s in mine[:-5]:
            sh(["zfs", "destroy", s], log)
    return rc == 0, snap if rc == 0 else "zfs snapshot failed: " + " ".join(tail[-2:])


def do_run(conf, reason="manual", runner=sh):
    """returns the status dict; the caller has the lock"""
    os.makedirs(LOG_DIR, exist_ok=True)
    started = now()
    st = {"version": VERSION, "host": socket.gethostname(), "started": started, "started_iso": iso(started), "result": "running",
          "trigger": reason, "steps": {}, "last_success": read_status().get("last_success")}
    logpath = os.path.join(LOG_DIR, time.strftime("run-%Y%m%d-%H%M%S.log"))
    st["log"] = logpath
    write_status(st)
    failed_step, error = None, ""

    def fail(step, msg):
        nonlocal failed_step, error
        if failed_step is None:
            failed_step, error = step, msg

    with open(logpath, "w") as log:
        log.write(f"horcrux-autoupdate {VERSION} {iso(started)} trigger={reason}\n")
        if yes(conf["SYNC"]):
            ok, detail, err, warns = do_sync(conf, log, runner)
            st["steps"]["sync"] = detail
            if warns:
                st["warnings"] = warns
            if not ok:
                fail("sync", err)
        ok, detail = snapshot(log, conf)
        st["steps"]["snapshot"] = detail
        if not ok:
            fail("snapshot", detail)  # no rollback point: do not touch the system
        merged = []
        if failed_step != "snapshot":
            off = size_of(EMERGE_LOG)
            rc, tail = runner(prio(["emerge"] + world_args(conf)), log, timeout=int(float(conf["MAX_RUNTIME_HOURS"]) * 3600))
            st["steps"]["update"] = rc
            merged = merged_since(off)
            st["merged"] = len(merged)
            if rc != 0:
                fail("update", "emerge @world failed: " + " | ".join(tail[-4:]))
            elif conf["DEPCLEAN"] == "safe":
                rc, lines = runner(prio(["emerge", "--ask=n", "--color=n", "--nospinner", "--depclean", "--pretend", bdeps_opt(conf)]), log, full=True)
                if rc != 0:
                    st["steps"]["depclean"] = "skipped: pretend run failed"
                else:
                    atoms = parse_depclean("\n".join(lines))
                    remove, kept, why = depclean_plan(atoms, conf)
                    kept_note = f" (kept protected: {' '.join(dict.fromkeys(kept))})" if kept else ""
                    if why:
                        st["steps"]["depclean"] = f"skipped: {why}{kept_note}"
                    elif not remove:
                        st["steps"]["depclean"] = "nothing to remove" + kept_note
                    else:
                        rc, tail = runner(prio(["emerge", "--ask=n", "--color=n", "--nospinner", "--depclean", bdeps_opt(conf)] + remove), log)
                        st["steps"]["depclean"] = f"removed {len(remove)}{kept_note}" if rc == 0 else rc
                        if rc != 0:
                            fail("depclean", "emerge --depclean failed: " + " | ".join(tail[-3:]))
            else:
                st["steps"]["depclean"] = "disabled"
            if failed_step is None and yes(conf["PRESERVED_REBUILD"]) and os.path.exists(PRESERVED) and size_of(PRESERVED) > 3:
                off2 = size_of(EMERGE_LOG)
                rc, tail = runner(prio(["emerge"] + emerge_opts(conf) + ["--keep-going", "@preserved-rebuild"]), log)
                st["steps"]["preserved-rebuild"] = rc
                merged += merged_since(off2)
                if rc != 0:
                    fail("preserved-rebuild", "emerge @preserved-rebuild failed: " + " | ".join(tail[-3:]))
            if failed_step is None and conf["ETC_UPDATE"] != "off" and shutil.which("etc-update"):
                args = ["etc-update", "--preen"] if conf["ETC_UPDATE"] == "preen" else ["etc-update", "--automode", "-5"]
                rc, tail = runner(prio(args), log)
                st["steps"]["etc-update"] = rc
                if rc != 0:
                    fail("etc-update", "etc-update failed: " + " | ".join(tail[-3:]))
            if failed_step is None:
                st["config_updates_pending"] = count_config_updates()
            # the update replaced the manager's program: run the new one (guests keep running; waits while somebody uses it)
            summary, pending = restart_replaced(conf, log, runner)
            st["steps"]["restart"] = summary
            record_restart(summary, pending)
            log.write(f"restart: {summary}\n")
        # a package that needs a reboot counts even when a later step failed
        reasons = reboot_reasons(merged, conf)
        if reasons:
            add_reboot_reasons(reasons)
        # pending count, after everything
        if failed_step != "snapshot":
            rc, lines = runner(prio(["emerge", "--ask=n", "--color=n", "--nospinner", "--pretend"] + resolve_opts(conf) + ["@world"]), None, full=True)
            if rc == 0:
                st["pending"] = len(parse_pending("\n".join(lines)))
        log.write(f"result: {'failed ' + failed_step if failed_step else 'ok'}\n")
    finished = now()
    st.update({"finished": finished, "finished_iso": iso(finished), "duration": finished - started})
    needed, why = reboot_state()
    st["reboot_required"], st["reboot_reasons"] = needed, why
    if failed_step:
        st.update({"result": "failed", "failed_step": failed_step, "error": error})
    else:
        st.update({"result": "ok", "last_success": finished})
    write_status(st)
    prune_logs()
    sh(["logger", "-t", "horcrux-autoupdate", f"{st['result']}" + (f" ({failed_step}: {error[:200]})" if failed_step else
                                                                   f" merged={st.get('merged', 0)} pending={st.get('pending', '?')} reboot={needed}")])
    return st


def pretend_text(conf=None):
    return "\n".join(sh(["emerge", "--ask=n", "--color=n", "--nospinner", "--pretend"] + resolve_opts(conf or read_conf()) + ["@world"],
                         None, full=True)[1])


def count_config_updates():
    n = 0
    try:
        prot = subprocess.run(["portageq", "envvar", "CONFIG_PROTECT"], capture_output=True, text=True).stdout.split()
    except OSError:
        return None
    for d in prot:
        for _r, _d, files in os.walk(d):
            n += sum(1 for f in files if f.startswith("._cfg"))
    return n


def due(conf, st):
    last = st.get("started") or 0
    return now() - last >= float(conf["INTERVAL_HOURS"]) * 3600


def restart_only(conf, force=False, quiet=True):
    """the hourly trigger between updates (and `restart-services`): restart a manager whose program an update - or an emerge by hand -
    replaced; a cheap /proc + cgroup scan when there is nothing to do"""
    try:
        fd = take_lock()
    except Locked:
        return 0
    try:
        if other_emerge_running():
            return 0  # a merge may be replacing the program right now
        os.makedirs(LOG_DIR, exist_ok=True)
        with open(os.path.join(LOG_DIR, "restart.log"), "a") as log:
            summary, pending = restart_replaced(conf, log, force=force)
            if summary != "nothing to restart" or restart_pending()[0]:
                log.write(f"{iso(now())} {summary}\n")
        record_restart(summary, pending)
        if summary not in ("nothing to restart", "disabled"):
            st = read_status()
            changed = (st.get("restart") or {}).get("result") != summary
            if st:
                st["restart"] = {"at": now(), "at_iso": iso(now()), "result": summary}
                write_atomic(state_path("status.json"), json.dumps(st, indent=2, sort_keys=True) + "\n")
            if changed:
                sh(["logger", "-t", "horcrux-autoupdate", f"restart: {summary}"])
        if not quiet:  # cron/timer runs stay silent: the result is in restart.log, status and syslog
            print(summary)
        return 1 if summary.startswith("restart failed") else 0
    finally:
        os.close(fd)


def cmd_run(a, only_if_due):
    conf = read_conf()
    if not yes(conf["ENABLED"]):
        st = {"version": VERSION, "host": socket.gethostname(), "result": "disabled", "finished": now(), "finished_iso": iso(now()),
              "last_success": read_status().get("last_success")}
        write_status(st)
        return 0
    st0 = read_status()
    if only_if_due and not due(conf, st0):
        return restart_only(conf)
    try:
        fd = take_lock()
    except Locked:
        print("another horcrux-autoupdate run holds the lock", file=sys.stderr)
        return 0
    try:
        if other_emerge_running():
            print("an emerge is already running; trying again later", file=sys.stderr)
            return 0  # not a failure, and it does not reset the interval
        if yes(conf["SKIP_ON_BATTERY"]) and on_battery():
            print("on battery power; trying again later", file=sys.stderr)
            return 0
        st = do_run(conf, "cron" if only_if_due else "manual")
    finally:
        os.close(fd)
    return 0 if st["result"] == "ok" else 1


def check_result(conf, st, rb=None):
    """(code, text) for `check`"""
    if not yes(conf["ENABLED"]):
        return 0, "autoupdate disabled by configuration"
    if not st:
        return 1, "autoupdate has not run yet"
    day = 86400
    stale = float(conf["STALE_DAYS"]) * day
    t = now()
    last = st.get("last_success")
    age = (t - last) if last else None
    if st.get("result") == "running":
        if t - st.get("started", t) > float(conf["MAX_RUNTIME_HOURS"]) * 3600 + 3600:
            return 2, "autoupdate run interrupted (started %s, no result)" % st.get("started_iso")
    if st.get("result") == "failed":
        return 2, f"autoupdate FAILED at {st.get('failed_step')}: {st.get('error', '')[:200]} (log {st.get('log')})"
    if age is None or age > 2 * stale:
        return 2, "no successful autoupdate for %s" % ("ever" if age is None else f"{age / day:.1f} days")
    if age > stale:
        return 1, f"last successful autoupdate {age / day:.1f} days ago"
    msg = f"autoupdate ok {age / day:.1f} days ago, pending={st.get('pending', '?')}"
    needed = st.get("reboot_required") if rb is None else rb
    if needed:
        msg += ", reboot required: " + "; ".join(st.get("reboot_reasons", []))
    since, why = restart_pending()
    if since:
        msg += f", service restart waiting since {iso(since)}: {why}"
        if why.startswith("restart failed") or t - since > stale:
            return 1, msg
    if st.get("warnings"):
        return 1, msg + ", warning: " + "; ".join(st["warnings"])[:200]
    return 0, msg


def main(argv=None):
    ap = argparse.ArgumentParser(prog="horcrux-autoupdate", description="automatic Portage updates; never reboots")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("cron", help="run when due")
    sub.add_parser("run", help="run now")
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    sub.add_parser("check")
    sub.add_parser("pending")
    p = sub.add_parser("restart-services", help="restart a Horcrux service whose program an update replaced (guests keep running)")
    p.add_argument("--now", action="store_true", help="do not wait for open client connections")
    a = ap.parse_args(argv)
    if a.cmd in ("cron", "run", "restart-services") and os.geteuid() != 0:
        print("horcrux-autoupdate: must run as root", file=sys.stderr)
        return 2
    if a.cmd == "restart-services":
        return restart_only(read_conf(), force=a.now, quiet=False)
    if a.cmd == "cron":
        return cmd_run(a, True)
    if a.cmd == "run":
        return cmd_run(a, False)
    st = read_status()
    needed, why = reboot_state()
    if a.cmd == "status":
        st.update({"reboot_required": needed, "reboot_reasons": why})
        print(json.dumps(st, indent=2, sort_keys=True) if a.json else
              "\n".join(f"{k}: {v}" for k, v in sorted(st.items())) or "no run yet")
        return 0
    if a.cmd == "check":
        code, text = check_result(read_conf(), st, needed)
        print(text)
        return code
    if a.cmd == "pending":
        txt = pretend_text()
        print("\n".join(parse_pending(txt)))
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
