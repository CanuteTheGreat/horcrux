#!/sbin/openrc-run
# sys-apps/horcrux-be: once the machine has booted (ZFS pool healthy, GOOD_DELAY seconds up), the running kernel becomes the known-good kernel
# and the default boot entry. A new kernel is booted ONCE as a trial; if it never gets here, the next boot is the last known-good kernel.
description="mark the running kernel known-good after a successful boot (horcrux-be)"
depend() {
	need localmount
	after *
}
start() {
	[ -e /etc/horcrux/be.conf ] || return 0
	ebegin "Scheduling the known-good kernel mark"
	# detached and untracked on purpose: a supervised daemon that exits after its one job would show up as "crashed" in rc-status
	( setsid sh -c '/usr/bin/horcrux-be mark-good --wait 2>&1 | logger -t horcrux-be-good' </dev/null >/dev/null 2>&1 & )
	eend 0
}
stop() {
	return 0
}
