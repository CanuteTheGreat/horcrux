[Unit]
Description=Mark the running kernel known-good after a successful boot (horcrux-be)
ConditionPathExists=/etc/horcrux/be.conf
After=multi-user.target zfs.target
# a trial kernel that never reaches this point is not promoted: the next boot is the previous known-good kernel again

[Service]
Type=simple
# the job exits after marking the kernel good: stay 'active (exited)' (OpenRC parity), not an inactive/stopped enabled service
RemainAfterExit=yes
ExecStart=/usr/bin/horcrux-be mark-good --wait

[Install]
WantedBy=multi-user.target
