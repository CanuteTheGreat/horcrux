#!/sbin/openrc-run
description="T2 Mac fan daemon"
command="/usr/bin/t2fanrd"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
	need localmount
	after modules udev
}

# applesmc binds to the ACPI device APP0001 and appears several seconds after
# udev settles (about 19 s on a MacBookPro16,2), so wait for its fan nodes
# instead of failing the service at boot. t2fanrd globs the same path.
start_pre() {
	local i=0
	while [ $i -lt 60 ]; do
		set -- /sys/devices/pci*/*/*/*/APP0001:00/fan*_manual
		[ -e "$1" ] && return 0
		sleep 1; i=$((i + 1))
	done
	eerror "no applesmc fan interface after 60 s (T2 kernel's applesmc missing?)"
	return 1
}
