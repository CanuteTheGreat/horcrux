#!/usr/bin/python3
"""Import the Apple Wi-Fi/Bluetooth firmware of a T2 Mac (never shipped by Horcrux).

  horcrux-t2-firmware                  scan mounted disks for an old install or a firmware.tar
  horcrux-t2-firmware PATH             PATH = firmware.tar[.gz|.xz] or a /lib/firmware/brcm style directory
Installs into /lib/firmware/brcm of the running system, then reloads the drivers."""
import os, subprocess, sys
sys.path.insert(0, "/usr/lib/live-installer")
from liveinst import t2

def main():
    root = os.environ.get("HORCRUX_ROOT", "/")
    if len(sys.argv) > 1:
        src = sys.argv[1]
        kind = "dir" if os.path.isdir(src) else "tar"
    else:
        found = t2.find_firmware_sources()
        if not found:
            print("No firmware found. Give the path of firmware.tar (made on macOS/Linux with the t2linux firmware.sh).")
            return 1
        for i, f in enumerate(found):
            print(f"[{i}] {f['kind']:<4} {f['path']}  ({f['apple']} Apple files)")
        src, kind = found[0]["path"], found[0]["kind"]
        print("using", src)
    done = t2.import_firmware(src, root, kind)
    print(f"installed {len(done)} files into {root.rstrip('/')}/lib/firmware/brcm")
    if root == "/":
        subprocess.run("modprobe -r brcmfmac_wcc brcmfmac 2>/dev/null; modprobe brcmfmac; modprobe hci_bcm4377 2>/dev/null; true", shell=True)
    return 0 if done else 1

sys.exit(main())
