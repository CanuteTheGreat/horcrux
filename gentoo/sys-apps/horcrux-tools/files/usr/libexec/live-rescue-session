#!/bin/sh
# login program for the rescue consoles (agetty -n -l): the rescue menu, then a live root shell.
dmesg -n 1 2>/dev/null
export TERM=${TERM:-linux}
mode=$(cat /run/live-installer/mode 2>/dev/null || echo rescue)
echo "[live-rescue] boot mode: $mode"
/usr/bin/live-rescue "$mode"
echo
echo "Live system shell (root). Run 'live-rescue' to open the rescue menu again, 'reboot' to restart."
exec /bin/login -f root
