# wdmd keeps its pid file in /run/wdmd (WDMD_RUN_DIR), not /var/run.
pidfile="/run/wdmd/wdmd.pid"
command="/usr/sbin/wdmd"
command_args="${WDMDOPTS:-"-G sanlock"}"

depend() {
	need localmount
}

start_pre() {
	$command -p || exit 1
}
