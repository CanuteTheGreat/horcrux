# t2linux patch set + kernel pin used by gentoo/t2 (keep in sync with docs/T2-MACS.md)
# Gentoo dropped every 7.2.x kernel and OpenZFS 2.3.x stops at 7.2: the kernel is the 6.18 LTS series (same pin as sys-kernel/horcrux-t2-config-2,
# which the binhost lane amd64/t2 builds; keep both in sync).
T2_PATCHES_REPO=https://github.com/t2linux/linux-t2-patches.git
# tip of t2linux's `6.18` branch (its version file says KVER=6.18.56); 22 non-APFS patches apply to gentoo-kernel 6.18.64
T2_PATCHES_COMMIT=bf06511b536a75fcea3146aa341f183c2a2daebc
# Gentoo's patched tree this applies to (all non-APFS patches apply with no fuzz and no rejects)
KERNEL_PKG="=sys-kernel/gentoo-sources-6.18.64-r1"
KERNEL_SRC_DIR=linux-6.18.64-gentoo-r1
LOCALVERSION=-t2-horcrux
# APFS (8001/8002) is skipped: macOS is gone and the driver is out-of-tree code we do not want to carry
SKIP_PATCHES="8001-* 8002-*"
