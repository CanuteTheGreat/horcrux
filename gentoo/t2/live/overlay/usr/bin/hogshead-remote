#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# hogshead-remote: start sshd (key-only) and bring up Tailscale non-interactively with the baked one-time auth key.
# Needs a working network first (nmtui for Wi-Fi). Prints the Tailscale and LAN IPs.
set -u
[ "$(id -u)" = 0 ] || { echo "run as root"; exit 1; }
SOCK=/run/tailscale/tailscaled.sock
KEY=/etc/hogshead/ts-authkey
[ -s /run/hogshead-keys/ts-authkey ] && KEY=/run/hogshead-keys/ts-authkey   # a HSKEYS stick can override (tests)
HOST=hogshead-live
ts() { tailscale --socket=$SOCK "$@"; }
lanips() { ip -4 -o addr show scope global 2>/dev/null | awk '$2!="tailscale0"{split($4,a,"/"); print "  " a[1] "  (" $2 ")"}'; }

echo "== network"
if ! ip -4 route show default | grep -q .; then
  echo "No default route: the laptop is not online yet."
  echo "  Wi-Fi:     nmtui   (Activate a connection)     Ethernet/USB-C dongle: plug it in, DHCP is automatic"
  exit 1
fi
ip -4 route show default | head -2
echo "== sshd (key-only)"
rc-service sshd status >/dev/null 2>&1 || rc-service sshd start >/dev/null 2>&1
rc-service sshd status 2>&1 | tail -1
echo "== clock"
# the live system has no trustworthy clock until the RTC/NTP is right; TLS (tailscale, curl) fails on a wrong date.
# Plain-HTTP Date header = no certificate check needed.
d=$(curl -sI -m 8 http://www.google.com 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | head -1)
if [ -n "$d" ] && date -u -s "$d" >/dev/null 2>&1; then echo "clock set to: $(date -u)"; else echo "clock left as: $(date -u) (no plain-HTTP time source reachable)"; fi
echo "== tailscale"
hostname "$HOST" 2>/dev/null
modprobe tun 2>/dev/null
rc-service tailscaled status >/dev/null 2>&1 || rc-service tailscaled start >/dev/null 2>&1
i=0; while [ ! -S $SOCK ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i+1)); done
if ts status --json 2>/dev/null | grep -q '"BackendState": "Running"'; then
  echo "already connected"
else
  if [ ! -s "$KEY" ]; then
    echo "No auth key baked in ($KEY missing). Run:  tailscale up --hostname=$HOST   and open the printed URL."
  else
    # the key is passed as a file so it never shows up in the process list
    if ! ts up --auth-key="file:$KEY" --hostname="$HOST" --accept-dns=false --accept-routes=false --ssh=false --timeout=60s; then
      echo
      echo "Tailscale refused the key (expired after 7 days, or already used?)."
      echo "--- tailscaled log (tail):"; tail -n 12 /var/log/tailscaled.log 2>/dev/null | sed -E 's/tskey-[A-Za-z0-9-]+/tskey-***/g'
      echo "Fallback: plain LAN ssh (below), or run:  tailscale --socket=$SOCK up --hostname=$HOST   and open the URL."
    fi
  fi
fi
tsip=$(ts ip -4 2>/dev/null | head -1)
echo
echo "================= give these to Claude ================="
echo "Tailscale IP : ${tsip:-<not connected>}"
echo "LAN IP(s)    :"; lanips
echo "ssh          : key-only (root@<ip>)   hostname: $HOST"
echo "========================================================="
[ -n "$tsip" ]
