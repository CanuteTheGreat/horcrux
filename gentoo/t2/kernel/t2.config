# T2 + hogshead kernel options merged on top of Gentoo's distribution-kernel config (scripts/kconfig/merge_config.sh).
# The t2linux `extra_config` is merged AFTER this file by build-kernel.sh, so t2linux's own requirements win.
CONFIG_LOCALVERSION="-t2-horcrux"
# --- Apple T2 core (t2linux patches 1001/1002): BCE mailbox/DMA, virtual USB host (keyboard/trackpad/Touch Bar), audio
CONFIG_T2BCE_CORE=m
CONFIG_T2BCE_DMA=m
CONFIG_T2BCE_VHCI=m
CONFIG_T2BCE_AUDIO=m
# --- keyboard / trackpad / Touch Bar
CONFIG_HID=y
CONFIG_HID_APPLE=m
CONFIG_HID_APPLETB_KBD=m
CONFIG_HID_APPLETB_BL=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_DRM_APPLETBDRM=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_HID_MULTITOUCH=m
CONFIG_APPLE_MFI_FASTCHARGE=m
# --- Wi-Fi / Bluetooth (BCM4364 = brcmfmac PCIe; the T2 patches 9003 add the D3 timeout fix)
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMUTIL=m
CONFIG_BT_BCM=m
CONFIG_BT_HCIBCM4377=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
# --- graphics: Ice Lake Iris Plus G7 = i915; gmux (patch 2009) for the dual-GPU 16,1 family
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_APPLE_GMUX=m
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
# --- SMC / sensors / fans / battery (3001-3009 applesmc rework)
CONFIG_SENSORS_APPLESMC=m
CONFIG_SND_PCM=m
CONFIG_STAGING=y
CONFIG_I2C=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# (Thunderbolt 3/4 = the USB4 driver, module name "thunderbolt")
# --- storage: Apple ANS2 NVMe (106b:2005) is a plain PCIe NVMe with in-tree quirks; VMD/Thunderbolt/USB-C
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_CORE=m
CONFIG_NVME_HWMON=y
CONFIG_USB4=m
CONFIG_USB4_NET=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_TYPEC_TBT_ALTMODE=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=n
# --- live image plumbing + disk tools
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_ISO9660_FS=m
CONFIG_VFAT_FS=m
CONFIG_DM_CRYPT=m
CONFIG_BLK_DEV_DM=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
# --- OpenZFS builds against this tree as an out-of-tree module
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_COMPRESS_XZ is not set
# CONFIG_MODULE_COMPRESS_ZSTD is not set
# --- trim what a hogshead boot never needs (build time + ISO size; the rest of the Gentoo dist config stays)
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_XE is not set
# CONFIG_INFINIBAND is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DRM_KUNIT_TEST is not set
