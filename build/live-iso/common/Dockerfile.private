# syntax=docker/dockerfile:1.4
# PRIVATE layer (PRIV_DIR=<dir outside the repo> build.sh): the owner's secrets/keys baked into the image, on top of the finished
# rootfs. Never published publicly. Files land in /usr/share/horcrux-surface-private (root 0700/0600), e.g.
#   authorized_keys  (the owner's ssh PUBLIC keys: key-only root ssh for the remote hand-off)
#   hostname         (REQUIRED: the owner's name for this machine, e.g. madammalkins; prefilled and confirmed by the installer)
ARG BASE
FROM ${BASE}
COPY --from=priv --chmod=0600 / /usr/share/horcrux-surface-private/
# Tailscale is retired: a stale ts-authkey left in an old PRIV_DIR must never reach the image
RUN rm -f /usr/share/horcrux-surface-private/ts-authkey && chmod 0700 /usr/share/horcrux-surface-private && chown -R root:root /usr/share/horcrux-surface-private && ls -la /usr/share/horcrux-surface-private 
