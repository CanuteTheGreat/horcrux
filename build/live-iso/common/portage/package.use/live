# initramfs generator used by gentoo-kernel-bin's installkernel hook
# -systemd (and no UKI): the classic installkernel hooks on BOTH inits, so a kernel is always /boot/vmlinuz-<ver> + initramfs-<ver>.img, the layout
# GRUB's generated config, horcrux-be and the installer use (with USE=systemd, kernel-install wrote /boot/kernel-<ver> on the systemd image)
sys-kernel/installkernel dracut -systemd -systemd-boot -uki -ukify
sys-kernel/linux-firmware redistributable initramfs
sys-boot/grub device-mapper
net-dns/dnsmasq script dhcp ipv6
net-libs/gnutls pkcs11 tools
sys-fs/squashfs-tools lzma zstd lzo xattr

# the guided installer's portable xfs-luks layout is LUKS2 -> LVM (hibernate swap LV): needs pvcreate/vgcreate/lvcreate, which
# sys-fs/lvm2 only installs with USE=lvm (default off: just dmsetup)
sys-fs/lvm2 lvm
