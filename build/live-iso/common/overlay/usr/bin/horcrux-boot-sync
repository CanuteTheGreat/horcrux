#!/bin/bash
# horcrux-boot-sync [--init]
# Multi-disk ZFS install: every extra drive carries its own copy of /boot (ext4) and its own bootable ESP
# (grub --removable), so ANY drive's ESP can boot the machine (BIOS boot order, a replaced first drive).
# Drive 1 is the master: after every kernel install / boot-environment change this copies /boot to the other
# drives and re-runs grub-install for their ESPs. Config: /etc/horcrux/boot-mirrors.conf = "<disk> <esp-uuid> <boot-uuid>".
# NOTE: a pool striped over several drives has NO redundancy: this only keeps the boot path symmetric.
set -u
CONF=/etc/horcrux/boot-mirrors.conf
# sync_tree SRC DST: copy SRC onto the ext4 boot copy DST without ever deleting anything that is still needed.
# 1. refuse when the tree (hardlinks counted once) cannot fit the copy at all: nothing is written then
# 2. pass 1 relinks files the copy already holds as separate copies (what a link-unaware older sync left behind): this frees
#    space on an already-full copy; only touches files that exist on both sides
# 3. pass 2 adds/updates files (rsync writes a temp file and renames, so a failure leaves the old file)
# 4. on ENOSPC, drop what the master no longer has and try pass 2 once more
RSYNC_OPTS=(-aHqx)
sync_tree() {
    local s=$1 t=$2 need cap ex=(--exclude lost+found --exclude /efi --exclude /grub/grub.cfg)
    need=$(du -sx --block-size=1 --exclude=lost+found --exclude=efi --exclude=grub/grub.cfg "$s" | cut -f1)
    cap=$(df -B1 --output=size "$t" | tail -1 | tr -d ' ')
    # 5 % ext4 reserve + journal/metadata headroom
    if [ -n "$need" ] && [ -n "$cap" ] && [ "$need" -gt $((cap * 90 / 100)) ]; then
        echo "horcrux-boot-sync: $s needs $((need / 1048576)) MiB but the copy holds only $((cap / 1048576)) MiB: not syncing (shrink the kernels kept: KERNELS_KEEP in /etc/horcrux/be.conf)" >&2
        return 1
    fi
    rsync "${RSYNC_OPTS[@]}" --existing "${ex[@]}" "$s/" "$t/" 2>/dev/null || true
    rsync "${RSYNC_OPTS[@]}" "${ex[@]}" "$s/" "$t/" && return 0
    rsync "${RSYNC_OPTS[@]}" --delete "${ex[@]}" "$s/" "$t/" 2>/dev/null || true
    rsync "${RSYNC_OPTS[@]}" "${ex[@]}" "$s/" "$t/"
}
[ "${HORCRUX_BOOT_SYNC_LIB:-}" = 1 ] && return 0
[ -r "$CONF" ] || exit 0
mode=${1:-sync}
rc=0
src=$(findmnt -no UUID /boot) || { echo "horcrux-boot-sync: /boot is not mounted" >&2; exit 1; }
case $(uname -m) in
    aarch64|arm64) efi_target=arm64-efi ;;
    riscv64)       efi_target=riscv64-efi ;;
    *)             efi_target=x86_64-efi ;;
esac
[ -d /sys/firmware/efi ] || [ -d /boot/efi/EFI ] || efi_target=""
[ -n "$efi_target" ] || exit 0
n=0
while read -r disk esp boot _; do
    case $disk in ''|\#*) continue ;; esac
    n=$((n + 1))
    d=/run/horcrux-bootmirror/$n
    mkdir -p "$d/boot" "$d/efi"
    if ! mount -t ext4 "UUID=$boot" "$d/boot"; then echo "horcrux-boot-sync: cannot mount boot copy $n ($boot)" >&2; rc=1; continue; fi
    if ! mount -t vfat -o umask=0077 "UUID=$esp" "$d/efi"; then echo "horcrux-boot-sync: cannot mount ESP $n ($esp)" >&2; umount "$d/boot"; rc=1; continue; fi
    # kernels, initramfs, per-BE directories, grub modules/fonts; the grub.cfg is rewritten for this copy below.
    # /boot/be holds hardlinked boot-environment snapshots (the same kernel under many names): the copy MUST keep the links (-H),
    # or a 1.2 GiB /boot needs 2.1 GiB on the copy and the sync dies with ENOSPC (2026-11-27, kernel 6.18.65 install failed).
    if sync_tree /boot "$d/boot"; then
        mkdir -p "$d/boot/grub"
        sed "s/$src/$boot/g" /boot/grub/grub.cfg > "$d/boot/grub/grub.cfg.new" && mv "$d/boot/grub/grub.cfg.new" "$d/boot/grub/grub.cfg" || rc=1
        # only now (every file the new menu names is on the copy) drop what the master no longer has
        rsync "${RSYNC_OPTS[@]}" --delete --exclude lost+found --exclude /efi --exclude /grub/grub.cfg /boot/ "$d/boot/" || rc=1
    else
        # the copy keeps its OLD grub.cfg and ESP: they still match the files that are on it, so this drive stays bootable
        echo "horcrux-boot-sync: boot copy $n ($boot) NOT updated (kept as it was)" >&2
        rc=1
        umount "$d/efi" "$d/boot"
        continue
    fi
    # the ESP of this drive: GRUB whose prefix points at THIS drive's /boot copy
    grub-install --target="$efi_target" --efi-directory="$d/efi" --boot-directory="$d/boot" \
        --bootloader-id=Horcrux --removable >/dev/null || { echo "horcrux-boot-sync: grub-install for $disk failed" >&2; rc=1; }
    sync
    umount "$d/efi" "$d/boot"
    [ "$mode" = "--init" ] && echo "horcrux-boot-sync: drive $n ($disk) bootable"
done < "$CONF"
rmdir /run/horcrux-bootmirror/* /run/horcrux-bootmirror 2>/dev/null
exit $rc
