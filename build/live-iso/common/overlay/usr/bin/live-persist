#!/usr/bin/python3
"""live-persist: optional persistence (plain or LUKS2-encrypted) and the live product session for "Try it live".

  live-persist create [--device DEV] [--encrypt]   make the persistence partition (default: free space on the boot stick)
  live-persist start                               boot service: mount + overlay when it is not encrypted
  live-persist unlock-interactive                  console session: unlock / offer to create, then overlay
  live-persist product start|restart               start the product services (random admin password for THIS session)
  live-persist banner                              print the live web address, login and persistence state
  live-persist status

Persistence stores per-directory overlayfs upper layers (/etc /root /home /var/lib /var/log) on a partition labelled
<PROJECT>-PERSIST: the live system (squashfs) stays read-only underneath, the changes survive a reboot. With
--encrypt the partition is a LUKS2 container (passphrase asked on the console, never on the kernel command line).
Nothing on the machine's internal disks is touched: a persistence partition lives on the stick you booted from or
on a device you name.
"""
import fcntl
import json
import os
import re
import secrets
import shutil
import string
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/live-installer")
from liveinst import system as S  # noqa: E402

RUN = "/run/live-installer"
MNT = "/run/live-persist"
DIRS = ["/etc", "/root", "/home", "/var/lib", "/var/log"]
MAPPER = "live-persist"


def proj():
    return S.read("/etc/live-iso-label").replace("-live", "") or "live"


def label():
    return proj().upper() + "-PERSIST"


def sh(cmd, **kw):
    return subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, **kw)


def state(new=None):
    os.makedirs(RUN, exist_ok=True)
    p = RUN + "/persist-state"
    if new is not None:
        open(p, "w").write(new + "\n")
    return S.read(p, "off")


def wants_persistence():
    return bool(re.search(rf"(^| ){proj()}\.persist=", S.read("/proc/cmdline")))


def find():
    """(device, is_luks) of the persistence partition, or (None, False)"""
    r = sh(["blkid", "-L", label()])
    dev = r.stdout.strip()
    if r.returncode != 0 or not dev:
        return None, False
    t = sh(["blkid", "-s", "TYPE", "-o", "value", dev]).stdout.strip()
    return dev, t == "crypto_LUKS"


def activate(dev):
    """mount the (already opened) persistence file system and overlay the directories"""
    os.makedirs(MNT, exist_ok=True)
    r = sh(["mount", "-o", "rw,noatime", dev, MNT])
    if r.returncode != 0:
        print("persistence: cannot mount", dev, r.stderr.strip())
        return False
    for d in DIRS:
        slug = d.strip("/").replace("/", "_")
        up, wk = f"{MNT}/overlays/{slug}/upper", f"{MNT}/overlays/{slug}/work"
        os.makedirs(up, exist_ok=True)
        os.makedirs(wk, exist_ok=True)
        if not os.path.isdir(d):
            continue
        o = sh(["mount", "-t", "overlay", "overlay", "-o", f"lowerdir={d},upperdir={up},workdir={wk}", d])
        if o.returncode != 0:
            print(f"persistence: overlay of {d} failed: {o.stderr.strip()}")
    state("active")
    return True


def open_luks(dev, passphrase):
    r = subprocess.run(["cryptsetup", "open", "--key-file=-", dev, MAPPER], input=passphrase, capture_output=True, text=True)
    return r.returncode == 0


def cmd_start():
    if not wants_persistence():
        state("off")
        return 0
    sh("udevadm settle --timeout=20")
    dev, luks = find()
    if not dev:
        state("none")
        print("persistence requested but no", label(), "partition found (run 'live-persist create' or use the console prompt)")
        return 0
    if luks:
        state("locked")
        print("persistence: encrypted partition", dev, "found; it is unlocked on the console")
        return 0
    activate(dev)
    return 0


def read_pass(prompt):
    import getpass
    try:
        return getpass.getpass(prompt)
    except (EOFError, OSError):
        return input(prompt)


def prompt_watch(text, expect, secret=False):
    """Ask on this console; give up (None) when another console changed the persistence state meanwhile.
    The VGA and the serial console both show the question: whoever answers first wins."""
    import select
    import termios
    sys.stdout.write(text)
    sys.stdout.flush()
    fd = sys.stdin.fileno()
    old = None
    if secret and os.isatty(fd):
        old = termios.tcgetattr(fd)
        new = termios.tcgetattr(fd)
        new[3] &= ~termios.ECHO
        termios.tcsetattr(fd, termios.TCSADRAIN, new)
    buf = ""
    try:
        while True:
            if state() != expect:
                sys.stdout.write("\n(handled on another console)\n")
                return None
            r, _, _ = select.select([fd], [], [], 1.0)
            if not r:
                continue
            line = os.read(fd, 1024).decode(errors="replace")
            if line == "":
                return None
            buf += line
            if "\n" in buf or "\r" in buf:
                if secret:
                    sys.stdout.write("\n")
                return buf.replace("\r", "\n").split("\n")[0]
    finally:
        if old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


def cmd_unlock_interactive():
    if not wants_persistence():
        return 0
    os.makedirs(RUN, exist_ok=True)
    st = state()
    if st == "active":
        print("Persistence is active.")
    elif st == "locked":
        dev, _ = find()
        for _ in range(3):
            pw = prompt_watch(f"Passphrase for the encrypted persistence on {dev} (empty = skip): ", "locked", secret=True)
            if pw is None:
                break
            if pw == "":
                print("Skipped: continuing without persistence.")
                state("off")
                product("start")
                break
            with open(RUN + "/persist.lock", "w") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                if state() != "locked":
                    break
                if open_luks(dev, pw):
                    if activate("/dev/mapper/" + MAPPER):
                        print("PERSISTENCE-UNLOCKED")
                        product("restart")
                    break
            print("Wrong passphrase.")
        else:
            state("off")
            print("Continuing without persistence.")
            product("start")
    elif st == "none":
        print("No persistence partition ('" + label() + "') was found.")
        a = prompt_watch("Create one now on the boot stick (or another device)? [y/N] ", "none")
        if a is None or not a.strip().lower().startswith("y"):
            if a is not None:
                state("off")
            return 0
        state("creating")                     # the other console's question disappears
        enc = (prompt_watch("Encrypt it with a passphrase (LUKS2)? [Y/n] ", "creating") or "y").strip().lower() != "n"
        dev = (prompt_watch("Device (empty = free space on the boot stick): ", "creating") or "").strip()
        try:
            create(dev or None, enc, interactive=True)
            product("restart")
        except Exception as e:  # noqa
            print("Could not create the persistence partition:", e)
            state("off")
    return 0


def boot_disk():
    r = sh(["blkid", "-L", S.read("/etc/live-iso-volid")])
    part = r.stdout.strip()
    if not part:
        return None
    p = sh(["lsblk", "-no", "PKNAME", part]).stdout.strip().splitlines()
    return "/dev/" + p[0] if p and p[0] else None


def part_path(disk, n):
    return f"{disk}p{n}" if disk[-1].isdigit() else f"{disk}{n}"


def create(device, encrypt, interactive=False, passphrase=None):
    """make the partition; the machine's other disks are never touched. Returns the partition path."""
    disk = device
    if device and sh(["lsblk", "-no", "TYPE", device]).stdout.split()[:1] == ["part"]:
        part = device
    else:
        disk = device or boot_disk()
        if not disk:
            raise RuntimeError("cannot tell which disk the live medium is on; name a device")
        if not device:
            if sh(["lsblk", "-dno", "RM", disk]).stdout.strip() != "1" and not os.environ.get("LIVE_PERSIST_ANY_DISK"):
                raise RuntimeError("the boot medium is not a removable stick; name the device to use explicitly")
        has_pt = sh(["blkid", "-s", "PTTYPE", "-o", "value", disk]).stdout.strip()
        if has_pt:
            sh(["sgdisk", "-e", disk])               # a dd'd ISO leaves the backup GPT header mid-disk: move it to the end
        else:
            sh(["sgdisk", "-Z", disk])
        r = sh(["sgdisk", "-n", "0:0:0", "-t", "0:8300", "-c", "0:" + label(), disk])
        if r.returncode != 0:
            raise RuntimeError("no free space for a partition on " + disk + ": " + (r.stderr or r.stdout).strip()[-160:])
        sh(["partprobe", disk])
        sh("udevadm settle --timeout=20")
        time.sleep(1)
        out = sh(["sgdisk", "-p", disk]).stdout
        nums = [int(m.group(1)) for m in re.finditer(r"^\s*(\d+)\s", out.split("Number")[-1], re.M)]
        part = part_path(disk, max(nums))
    print("persistence partition:", part)
    if encrypt:
        pw = passphrase
        if pw is None:
            while True:
                pw = read_pass("New passphrase for the persistence: ")
                if len(pw) < 8:
                    print("Use at least 8 characters.")
                    continue
                if pw != read_pass("Repeat: "):
                    print("The passphrases differ.")
                    continue
                break
        r = subprocess.run(["cryptsetup", "luksFormat", "--type", "luks2", "--batch-mode", "--label", label(), "--key-file=-", part],
                           input=pw, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("luksFormat failed: " + r.stderr.strip()[-160:])
        if not open_luks(part, pw):
            raise RuntimeError("cannot open the new LUKS container")
        fsdev = "/dev/mapper/" + MAPPER
        r = sh(["mkfs.ext4", "-q", "-F", "-L", "PERSISTFS", fsdev])
    else:
        fsdev = part
        r = sh(["mkfs.ext4", "-q", "-F", "-L", label(), part])
    if r.returncode != 0:
        raise RuntimeError("mkfs failed: " + r.stderr.strip()[-160:])
    if device is None or interactive:
        activate(fsdev)
        print("PERSISTENCE-CREATED")
    elif encrypt:
        sh(["cryptsetup", "close", MAPPER])       # test/CLI use: leave it closed
    return part


# ---------------------------------------------------------------- the live product
def random_password():
    a = string.ascii_letters + string.digits
    while True:
        pw = "".join(secrets.choice(a) for _ in range(14)) + secrets.choice("-_#!") + secrets.choice(string.digits)
        if re.search(r"[a-z]", pw) and re.search(r"[A-Z]", pw) and re.search(r"\d", pw):
            return pw


def listening(port):
    return f":{port} " in sh(["ss", "-ltn"]).stdout


def product(action):
    p = S.load_profile()
    if state() == "locked":
        return 0                                  # started after the console unlocked the persistence
    web = p.get("web_service", "")
    svcs = p.get("live_services") or ([web] if web else [])
    port = p.get("web_port", 8443)
    info = {"title": p["title"], "scheme": p.get("web_scheme", "https"), "port": port, "password": None, "note": ""}
    db = p.get("db_path", "")
    existing = bool(db) and os.path.exists(db) and os.path.getsize(db) > 0
    pf = p.get("admin_password_file")
    if action == "restart":
        for s in reversed(svcs):
            sh(["rc-service", s, "stop"], timeout=120)
    prev = {}
    try:
        prev = json.load(open(RUN + "/live-info"))
    except (OSError, ValueError):
        pass
    if existing and prev.get("password"):
        info["password"] = prev["password"]        # restart after the persistence came up: the DB was seeded by this session's password
    elif existing:
        info["note"] = "persisted configuration: log in with the admin password you set earlier"
    elif pf:
        pw = random_password()
        os.makedirs(os.path.dirname(pf), exist_ok=True)
        fd = os.open(pf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(pw + "\n")
        owner = p.get("admin_password_owner", "root")
        sh(["chown", f"{owner}:{owner}", pf])
        info["password"] = pw
    os.makedirs(RUN, exist_ok=True)
    fd = os.open(RUN + "/live-info", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(info, f)
    for s in svcs:
        sh(["rc-service", s, "start"], timeout=180)
    if pf and info["password"]:
        # the seed file must not stay around once the service has read it
        subprocess.Popen(["sh", "-c", f"n=0; while [ $n -lt 300 ]; do if ss -ltn 2>/dev/null | grep -q ':{port} '; then sleep 5; rm -f {pf}; exit 0; fi; sleep 2; n=$((n+2)); done"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def primary_ip():
    for _ in range(40):
        r = sh("ip -4 -o addr show scope global | awk '{print $4}' | head -1 | cut -d/ -f1")
        if r.stdout.strip():
            return r.stdout.strip()
        time.sleep(1)
    return ""


def cmd_banner():
    try:
        info = json.load(open(RUN + "/live-info"))
    except (OSError, ValueError):
        info = {}
    ip = primary_ip()
    for _ in range(30):                                  # the product start runs in the background
        if info or not os.path.exists(RUN + "/mode") or S.read(RUN + "/mode") != "live":
            break
        try:
            info = json.load(open(RUN + "/live-info"))
        except (OSError, ValueError):
            time.sleep(1)
    title = info.get("title") or proj().title()
    print()
    print("=" * 64)
    print(f" {title} live session (nothing on the disks was touched)")
    print("=" * 64)
    if info:
        url = f"{info['scheme']}://{ip or '<address pending: check the network>'}:{info['port']}"
        print(f" Web UI         : {url}")
        if info.get("password"):
            print(f" Admin login    : admin")
            print(f" Admin password : {info['password']}")
            print("                  (random, valid for this live session only)")
        elif info.get("note"):
            print(f" Admin login    : {info['note']}")
    st = state()
    print(" Persistence    : " + {"active": "ACTIVE (" + (find()[0] or "?") + ")", "locked": "locked (not unlocked)", "none": "requested, no partition",
                                  "off": "off (changes are lost at power-off)"}.get(st, st))
    print(" To install     : run 'live-installer'.  Root shell below; sshd is off.")
    print("LIVE-SESSION-READY")
    print()
    return 0


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    c = argv[0]
    if c == "start":
        return cmd_start()
    if c == "unlock-interactive":
        return cmd_unlock_interactive()
    if c == "banner":
        return cmd_banner()
    if c == "status":
        print(state())
        return 0
    if c == "product":
        return product(argv[1] if len(argv) > 1 else "start")
    if c == "find":
        d, l = find()
        print(d or "")
        return 0 if d else 1
    if c == "create":
        dev = None
        enc = "--encrypt" in argv
        if "--device" in argv:
            dev = argv[argv.index("--device") + 1]
        pw = os.environ.get("LIVE_PERSIST_PASSPHRASE")      # scripted use only (tests); interactive use asks on the console
        try:
            create(dev, enc, passphrase=pw)
        except Exception as e:  # noqa
            print("error:", e)
            return 1
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
