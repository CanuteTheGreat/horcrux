#!/bin/sh
# Graphical installer hook: called by live-installer-session for the "Graphical install" boot entry.
# GTK4 installer in a cage kiosk on tty1 (own session bus for the AT-SPI probe). Exit status:
#   0  the GUI ran and the user chose reboot / shell / abort (the session then shows the live shell)
#   1  the GUI cannot start here (no display, nomodeset, no cage/GTK, crash at start): the session runs the text installer
proj=$(sed 's/-live$//' /etc/live-iso-label 2>/dev/null)
RUN=/run/live-installer; RES=$RUN/gui-result; mkdir -p $RUN
tty=$(tty 2>/dev/null)

gui_possible() {
	case "$tty" in /dev/tty[0-9]*) ;; *) return 1 ;; esac
	grep -qw nomodeset /proc/cmdline && return 1
	command -v cage >/dev/null 2>&1 || return 1
	python3 -c 'import gi' 2>/dev/null || return 1
	i=0; while [ $i -lt 20 ]; do ls /dev/dri/card* >/dev/null 2>&1 && return 0; sleep 0.5; i=$((i+1)); done
	echo "graphical installer: no display device found, using the text installer"
	return 1
}

run_gui() {
	mkdir -p /run/user/0; chmod 700 /run/user/0
	export XDG_RUNTIME_DIR=/run/user/0 LIBSEAT_BACKEND=builtin WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 \
	       GSK_RENDERER=cairo GDK_DISABLE=gl,vulkan,dmabuf LIVEINST_RESULT=$RES
	if [ -s $RUN/xkb ]; then read XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT < $RUN/xkb; export XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT; fi
	rm -f $RES
	# session bus (address saved for the AT-SPI probe /usr/libexec/live-installer-atspi). systemd: the logind session already has the user
	# manager's bus; use it, because a second (forked) session bus means a second AT-SPI bus launcher competing for the same a11y bus socket
	# under /run/user/0/at-spi, and the probe ended up on the other one (gui-atspi-tree: 0 accessible nodes). OpenRC: our own bus.
	own=
	if [ -d /run/systemd/system ] && [ -S /run/user/0/bus ]; then
		addr=unix:path=/run/user/0/bus
	else
		addr=$(dbus-daemon --session --fork --print-address 2>/dev/null); own=1
	fi
	export DBUS_SESSION_BUS_ADDRESS=$addr
	echo "$addr" > $RUN/dbus-address
	cage -s -- /usr/bin/live-installer --ui gui >$RUN/gui.log 2>&1
	# only the bus we forked (never the user manager's: its command line also says dbus-daemon --session)
	[ -n "$own" ] && pkill -f "dbus-daemon --session --fork" 2>/dev/null
	return 0
}

if gui_possible; then
	while :; do
		run_gui
		r=$(cat $RES 2>/dev/null)
		case "$r" in
			xkb) continue ;;
			reboot|shell|abort) exit 0 ;;
			*) echo "graphical installer did not start ($r)"; tail -5 $RUN/gui.log 2>/dev/null ;;
		esac
		break
	done
fi
exit 1
