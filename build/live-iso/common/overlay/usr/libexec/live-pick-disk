#!/bin/sh
# Print the first internal, non-removable disk >= 8 GiB that is not the
# device we booted from. Used only for <project>.autoinstall=1 without an
# explicit <project>.disk=.
live=$(readlink -f /run/initramfs/livedev 2>/dev/null)
livedisk=$(lsblk -no PKNAME "$live" 2>/dev/null | head -1)
lsblk -dnb -o NAME,TYPE,RM,SIZE | while read -r n t rm sz; do
	[ "$t" = disk ] || continue
	[ "$rm" = 0 ] || continue
	[ "$sz" -ge 8589934592 ] || continue
	[ "$n" = "$livedisk" ] && continue
	echo "/dev/$n"; break
done
