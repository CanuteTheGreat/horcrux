#!/sbin/openrc-run
# Serial console login, only when the kernel was told to use one
# (console=ttyS0 on the command line: QEMU tests, headless boxes).
description="Login prompt on ttyS0 when console=ttyS0 is set"
supervisor=supervise-daemon
command=/sbin/agetty
command_args="-L 115200 ttyS0 vt100"
depend() { after local; }
start_pre() {
	grep -q 'console=ttyS0' /proc/cmdline || { einfo "no console=ttyS0, skipping"; return 1; }
}
