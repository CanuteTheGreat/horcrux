#!/sbin/openrc-run
# Live-session console setup. Does nothing on an installed system.
#   <proj>.installer=1   guided installer on tty1 (or on the serial UART when console= names one)
#   <proj>.autoinstall=1 unattended install driven by an answer file (see docs/ISO-INSTALL.md)
#   <proj>.autoinstall.after=reboot  restart (sysrq) instead of poweroff when done/failed; <proj>.autoinstall.log=UUID=<vfat> copies the log there
#   neither              root shell on the consoles (the live system; sshd is OFF, root password is locked)
description="Live session: guided installer / unattended install / console shells"
depend() { need localmount; after local sysklogd dhcpcd; before live-serial; }

cmdarg() { grep -o "$1\\.$2=[^ ]*" /proc/cmdline | tail -1 | cut -d= -f2; }
proj() { sed 's/-live$//' /etc/live-iso-label 2>/dev/null; }

set_tty1() {
	# $1 = full agetty argument string for tty1
	if [ -d /run/systemd/system ]; then
		# systemd: getty@tty1 runs /usr/libexec/live-getty-tty1 (drop-in 00-live.conf), which reads these arguments; the unit is ordered
		# after this service, so at boot nothing needs a restart (only the later fallback to the interactive installer does)
		mkdir -p /run/live-installer; echo "$1" > /run/live-installer/tty1-args
		systemctl -q is-active getty@tty1.service 2>/dev/null && systemctl --no-block restart getty@tty1.service 2>/dev/null
		return 0
	fi
	sed -i '/^c1:/d' /etc/inittab
	echo "c1:12345:respawn:/sbin/agetty $1 tty1 linux" >> /etc/inittab
	telinit q 2>/dev/null
	pkill -f 'agetty.* tty1' 2>/dev/null
	return 0
}

# copy the (possibly partial) install log to the vfat volume named by <proj>.autoinstall.log=UUID=<esp> (only when it still exists: the disk may have been erased)
copy_install_log() {
	lg=$(cmdarg "$1" autoinstall.log | sed 's/^UUID=//'); [ -z "$lg" ] || { mkdir -p /run/autoinstall-log && mount -t vfat "/dev/disk/by-uuid/$lg" /run/autoinstall-log 2>/dev/null && { mkdir -p /run/autoinstall-log/EFI/HXSTAGE; cp /var/log/autoinstall.log /run/autoinstall-log/EFI/HXSTAGE/autoinstall.log 2>/dev/null; sync; umount /run/autoinstall-log 2>/dev/null; }; }
}

# Unattended restart flow: an install that never ends must not strand the machine (gringotts, 2026-11-07: answered ping for hours, every port closed,
# no log anywhere). (1) key-only sshd in the live system when the answer file carries ssh keys (state only in /run), so the lab can read the log;
# (2) a hard time limit (<proj>.autoinstall.timeout=SECONDS, default 3600): the install log is copied out and the machine restarts into whatever is on the disk.
# The caller kills the limit timer when the installer returns.
unattended_guard() {
	p=$1
	/usr/libexec/live-autoinstall-ssh 2>&1 | tee -a /var/log/autoinstall.log >/dev/console
	to=$(cmdarg "$p" autoinstall.timeout); case "$to" in ''|*[!0-9]*) to=3600 ;; esac
	(
		sleep "$to"
		echo "AUTOINSTALL-TIMEOUT after ${to}s: the installer did not finish; restarting into what is on the disk" | tee -a /var/log/autoinstall.log >/dev/console
		copy_install_log "$p"
		sync; echo 1 > /proc/sys/kernel/sysrq; echo b > /proc/sysrq-trigger
	) &
	echo $! > /run/autoinstall-timer.pid
}

start() {
	grep -q 'rd.live.image' /proc/cmdline || return 0
	/usr/libexec/live-os-release
	p=$(proj)
	serial=no; /usr/libexec/live-serial-dev >/dev/null && serial=yes
	dmesg -n 1 2>/dev/null
	if grep -q "${p}.autoinstall=1" /proc/cmdline; then
		set_tty1 "--noclear -a root"
		einfo "unattended install (answer file)"
		# <proj>.autoinstall.after=reboot: restart into the installed system (or, when the install failed/refused, into whatever is on the disk)
		# instead of powering off, so an unattended lab (no one to press the power button) gets its machine back. <proj>.autoinstall.log=UUID=<esp>
		# names a vfat partition to copy the install log to (only when it still exists: the disk may have been erased).
		after=$(cmdarg "$p" autoinstall.after); nohalt=; [ "$after" = reboot ] && nohalt=--no-halt
		: > /var/log/autoinstall.log
		[ "$after" = reboot ] && unattended_guard "$p"
		( /usr/bin/live-installer --answers auto $nohalt 2>&1; echo "AUTOINSTALL-EXIT rc=$?" ) | tee -a /var/log/autoinstall.log >/dev/console
		[ -s /run/autoinstall-timer.pid ] && { t=$(cat /run/autoinstall-timer.pid); c=$(pgrep -P "$t" 2>/dev/null); kill "$t" 2>/dev/null; [ -z "$c" ] || kill $c 2>/dev/null; rm -f /run/autoinstall-timer.pid; }   # the subshell first, then its sleep (killing the sleep first would let it fire)
		if [ "$after" = reboot ]; then
			# NOT /sbin/reboot: the live medium may live on the disk the installer just erased; sysrq needs no file from it
			copy_install_log "$p"
			echo "AUTOINSTALL-REBOOT after=reboot" >/dev/console; sync; sleep 3; echo 1 > /proc/sys/kernel/sysrq; echo b > /proc/sysrq-trigger
			return 0
		fi
		if grep -q 'ANSWER-FILE\|No answer file' /var/log/autoinstall.log; then
			ewarn "no usable answer file: starting the guided installer on the screen instead"
			echo "INSTALLER-FALLBACK-INTERACTIVE" >/dev/console
			set_tty1 "--noclear -n -l /usr/libexec/live-installer-session"
		fi
		return 0
	fi
	# boot menu modes (see common/boot/gen-grub-cfg.sh): the session programs read /run/live-installer/mode
	mkdir -p /run/live-installer
	mode=$(cmdarg "$p" installer); resc=$(cmdarg "$p" rescue); live=$(cmdarg "$p" live)
	if [ -n "$resc" ]; then
		[ "$resc" = forensic ] && mode=forensic || mode=rescue
		echo "$mode" > /run/live-installer/mode
		einfo "rescue session ($mode)"
		if [ "$serial" = yes ]; then set_tty1 "--noclear -a root"; else set_tty1 "--noclear -n -l /usr/libexec/live-rescue-session"; fi
		return 0
	fi
	if [ -n "$live" ]; then
		echo live > /run/live-installer/mode
		set_tty1 "--noclear -n -l /usr/libexec/live-session"
		return 0
	fi
	case "$mode" in gui) ;; expert) ;; surfaceauto) ;; 1) mode=text ;; *) mode=text ;; esac
	echo "$mode" > /run/live-installer/mode
	if [ -n "$(cmdarg "$p" installer)" ]; then
		if [ "$serial" = yes ] && [ "$mode" != gui ] && [ "$mode" != surfaceauto ]; then      # gui: tty1 keeps the graphical session, the UART gets a root shell (tests/support)
			set_tty1 "--noclear -a root"
		else
			set_tty1 "--noclear -n -l /usr/libexec/live-installer-session"
		fi
	else
		set_tty1 "--noclear -a root"
	fi
	return 0
}
