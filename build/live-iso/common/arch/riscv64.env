ARCH=riscv64
DEB_ARCH=riscv64
DOCKER_PLATFORM=linux/riscv64
STAGE3_TAG=rv64_lp64d-openrc
# boot: UEFI only (edk2 RISCV_VIRT / U-Boot EFI); GRUB riscv64-efi
EFI_GRUB_TARGET=riscv64-efi
EFI_BOOT_FILE=BOOTRISCV64.EFI
HAS_BIOS=0
GRUB_MODS_EXTRA=""
SERIAL_DEV=ttyS0
GRUB_SERIAL=0
SQFS_BCJ="-Xbcj riscv"
TRUNK_ARCH=""
QEMU_BIN=qemu-system-riscv64
QEMU_PKGS="qemu-system-misc qemu-efi-riscv64 u-boot-qemu"
CI_RUNNER=riscv64
