# Per-architecture build facts, sourced by build.sh, assemble-iso.sh (inside the tools image),
# ci-run.sh and qemu-test.py's helpers. One file per supported arch; add a file = add an arch.
ARCH=x86_64
DEB_ARCH=amd64
DOCKER_PLATFORM=linux/amd64
STAGE3_TAG=amd64-openrc
# boot: UEFI + legacy BIOS hybrid on x86
EFI_GRUB_TARGET=x86_64-efi
EFI_BOOT_FILE=BOOTX64.EFI
HAS_BIOS=1
GRUB_MODS_EXTRA="biosdisk"
# serial console the kernel/GRUB/getty use (QEMU: -serial)
SERIAL_DEV=ttyS0
GRUB_SERIAL=1
SQFS_BCJ="-Xbcj x86"
TRUNK_ARCH=x86_64
# test harness
QEMU_BIN=qemu-system-x86_64
QEMU_PKGS="qemu-system-x86 ovmf"
# the CI runner label that builds + tests this arch, and the speed factor for test timeouts
# (1 = KVM). Native TCG on a Graviton host without /dev/kvm is the aarch64 case.
CI_RUNNER=kvm-x86_64
