ARCH=aarch64
DEB_ARCH=arm64
DOCKER_PLATFORM=linux/arm64
STAGE3_TAG=arm64-openrc
# boot: UEFI only (AAVMF / real arm64 firmware); there is no BIOS on arm64
EFI_GRUB_TARGET=arm64-efi
EFI_BOOT_FILE=BOOTAA64.EFI
HAS_BIOS=0
GRUB_MODS_EXTRA=""
# QEMU virt / most SBCs: PL011 UART
SERIAL_DEV=ttyAMA0
# GRUB's `serial` command is x86-only in practice; on arm64 the EFI console (ConOut) is mirrored to the UART
GRUB_SERIAL=0
SQFS_BCJ="-Xbcj arm64"
TRUNK_ARCH=aarch64
QEMU_BIN=qemu-system-aarch64
QEMU_PKGS="qemu-system-arm qemu-efi-aarch64"
CI_RUNNER=arm64
