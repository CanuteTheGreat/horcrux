# server image: QEMU with SPICE (VM console), USB redirection, virtfs shares and VNC; the same lines app-emulation/horcrux-bin installs on a machine
app-emulation/qemu opengl spice usbredir virgl virtfs vnc zstd
# 3D virtio-gpu guests: Venus (Vulkan) in virglrenderer, host Vulkan drivers in Mesa
media-libs/virglrenderer venus
# qemu[opengl] needs libglvnd with X (EGL dispatch)
media-libs/libglvnd X
# headless host: Mesa without X for the 3D guests' EGL/Vulkan, drivers for the GPUs VMs can use (desktop layers set their own VIDEO_CARDS later)
media-libs/mesa vulkan -X VIDEO_CARDS: intel amdgpu radeonsi nouveau
media-libs/libepoxy -X
# podman -> netavark builds its firewall rules through the nftables json interface; same line horcrux-repo-config ships in horcrux-roles.use
net-firewall/nftables json
