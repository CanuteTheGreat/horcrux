#!/sbin/openrc-run
description="Horcrux API server and web UI (https://:8006)"
command=/usr/bin/horcrux-api
# supervised: the manager IS the HA supervisor (heartbeat, self-fence, recovery) of its node. A killed or crashed manager is restarted within seconds; without
# this a dead manager left the node unmanaged for good (lab finding 2026-11-06: pkill -KILL horcrux-api on a cluster node was never undone). `rc-service stop`
# stops the supervisor, so a deliberate stop stays stopped.
supervisor=supervise-daemon
respawn_delay=2
respawn_max=0
pidfile=/run/horcrux-api.pid
output_log=/var/log/horcrux/horcrux-api.log
error_log=/var/log/horcrux/horcrux-api.log
directory=/var/lib/horcrux
depend() { need net localmount; use logger libvirtd docker; }
start_pre() {
	checkpath -d -m 0755 /var/lib/horcrux /var/log/horcrux /etc/horcrux /etc/horcrux/ssl
	export HORCRUX_HOST=0.0.0.0 HORCRUX_PORT=8006 HORCRUX_DATA_DIR=/var/lib/horcrux \
		HORCRUX_DATABASE_URL=sqlite:///var/lib/horcrux/horcrux.db HORCRUX_SSL_DIR=/etc/horcrux/ssl \
		HORCRUX_UI_DIR=/usr/share/horcrux/ui
	# optional overrides (e.g. ADMIN_PASSWORD=... before the first start)
	[ -f /etc/conf.d/horcrux-api ] && . /etc/conf.d/horcrux-api
	# the guided installer leaves the admin password here for the FIRST start only; it is
	# deleted once the API is up (see /etc/local.d/50-installer-firstboot.start)
	if [ -s /etc/horcrux/admin-password ] && [ ! -s /var/lib/horcrux/horcrux.db ]; then
		export ADMIN_PASSWORD="$(head -n1 /etc/horcrux/admin-password)"
	fi
}
