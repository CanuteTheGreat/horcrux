# syntax=docker/dockerfile:1.4
# HOGSMEADE variant, part 2: everything after the (1 h) kernel / desktop / zfs+nvidia layers, on the proven hogshead packaging pattern.
# Part 1 = Dockerfile target hsm-kinstall (tagged and passed as BASE) so that changes to the overlay, the ebuilds or the Portage config
# in this part never recompile the kernel or the desktop. Named contexts: hxgentoo2 = the repo's gentoo/ (CURRENT horcrux overlay: horcrux-tools,
# horcrux-live-data, horcrux-unlock, rustinion-bin, hogsmeade-tools, awccd, comfyui), ctgoverlay, ctgprivate (ctg-private-overlay checkout), hsmprivate (NEVER in git).
ARG BASE
FROM ${BASE} AS hsm-final
ARG ARCH=x86_64
COPY --from=hxgentoo2 / /var/db/repos/horcrux/
COPY project/variants/hogsmeade/local-repo/ /var/db/repos/local/
COPY project/variants/hogsmeade/portage/ /etc/portage/
# hogshead/gnome-light fixes now in main: OpenRC GNOME fixes (gnome-base/gnome-session-openrc-49.2-r2::horcrux, no longer /etc/portage/patches), Firefox as the browser,
# cups-browsed zeroconf. The old image-local repo horcrux-desktop no longer exists (gnome-light ships an empty horcrux-gnome-light skeleton; ), so nothing needs unmerging.
COPY project/variants/gnome-light/portage/patches/ /etc/portage/patches/
COPY project/variants/owner-common/portage/package.accept_keywords/owner-apps /etc/portage/package.accept_keywords/owner-apps
COPY project/variants/gnome-light/portage/package.use/zz-desktop /etc/portage/package.use/zz-desktop
# sources of sys-apps/horcrux-tools (installer incl. the ZFS stripe layouts, scripts, boot-environment manager, ownership audit), straight from the repository tree
COPY common/overlay/usr/lib/live-installer /tmp/hxt/usr/lib/live-installer
COPY common/overlay/usr/libexec /tmp/hxt/usr/libexec
COPY common/overlay/usr/bin /tmp/hxt/usr/bin
COPY project/variants/hogshead/overlay/usr/bin/horcrux-orphans /tmp/hxt/usr/bin/horcrux-orphans
COPY project/variants/gnome-light/overlay/usr/share/horcrux/desktop /tmp/hxt/usr/share/horcrux/desktop
RUN --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache"; \
    rm -rf /var/db/repos/horcrux-desktop /etc/portage/repos.conf/horcrux-desktop.conf; \
    emerge --oneshot --usepkg=n --getbinpkg=n --buildpkg=n --select=y '>=gnome-base/gnome-session-openrc-49.2-r2'; \
    test -x /usr/libexec/gnome-session-openrc-helper && test ! -e /etc/portage/patches/gnome-base/gnome-session-openrc || { echo 'gnome-session-openrc::horcrux (session scoping) missing, or stale user patches'; exit 1; }; \
    if grep -q supervise-daemon /etc/user/init.d/gnome-settings-daemon-wayland /etc/user/init.d/gnome-settings-daemon-x11; then echo 'gsd supervisor patch not applied'; exit 1; fi; \
    grep -q 'want pipewire-pulse wireplumber' /etc/user/init.d/gsd || { echo 'gsd audio ordering patch not applied'; exit 1; }; \
    grep -q 'keep the shell there' /etc/user/init.d/gnome-shell-wayland || { echo 'gnome-shell user-bus patch not applied'; exit 1; }; \
    emerge --noreplace --select=y gnome-extra/gnome-shell-extensions gnome-extra/gnome-shell-extension-appindicator; \
    emerge --update --newuse --usepkg=n --getbinpkg=n --select gnome-extra/horcrux-gnome-defaults net-misc/horcrux-chrony-nm; \
    test -s /etc/dconf/db/local && test -f /etc/dconf/profile/user && qfile -q /etc/dconf/db/local
RUN --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    tar -C /tmp/hxt --zstd -cf /var/cache/distfiles/horcrux-tools-1.tar.zst .; rm -rf /tmp/hxt; \
    tar -C / --zstd -cf /var/cache/distfiles/horcrux-live-data-1.tar.zst usr/share/live-installer; \
    # both tarballs are made here from the CURRENT tree: a Manifest left by part 1 (older installer sources) would fail the checksum
    rm -f /var/db/repos/horcrux/sys-apps/horcrux-tools/Manifest /var/db/repos/horcrux/sys-apps/horcrux-live-data/Manifest /var/cache/distfiles/horcrux-*.tar.zst._checksum_failure_.*; \
    for e in /var/db/repos/horcrux/sys-kernel/horcrux-hogsmeade-config/*.ebuild /var/db/repos/horcrux/sys-apps/horcrux-live-data/*.ebuild /var/db/repos/horcrux/sys-kernel/horcrux-unlock/*.ebuild \
             /var/db/repos/horcrux/app-admin/rustinion-agent/*.ebuild /var/db/repos/horcrux/sys-apps/horcrux-tools/*.ebuild /var/db/repos/horcrux/app-misc/hogsmeade-tools/*.ebuild \
             /var/db/repos/horcrux/app-misc/awccd/*.ebuild /var/db/repos/horcrux/sci-misc/comfyui/*.ebuild /var/db/repos/horcrux/acct-user/comfyui/*.ebuild /var/db/repos/horcrux/acct-group/comfyui/*.ebuild \
             /var/db/repos/local/sys-apps/hogsmeade-private/*.ebuild /var/db/repos/local/app-misc/hogsmeade-obs/*.ebuild /var/db/repos/local/app-misc/hogsmeade-nextcloud/*.ebuild /var/db/repos/local/app-misc/hogsmeade-speaker-tuning/*.ebuild /var/db/repos/local/app-misc/hogsmeade-input-quirks/*.ebuild; do ebuild "$e" manifest; done; \
    # loose copies from the ISO overlay that packages own now: remove first so Portage owns the files
    # (the Horcrux manager itself is app-emulation/horcrux-bin from the core layer now: its files stay, only its services are not enabled here)
    rm -rf /usr/lib/live-installer /usr/libexec/live-* /usr/libexec/console-menu-session /usr/bin/live-installer /usr/bin/console-menu \
           /usr/bin/live-persist /usr/bin/live-rescue /usr/bin/horcrux-be /usr/bin/horcrux-t2-firmware /usr/share/horcrux/desktop; \
    # TPM-sealed unattended unlock (dracut 92tpm-unlock, loose in the ISO overlay, no package yet): HOGSMEADE unlocks with a typed passphrase
    rm -rf /usr/lib/dracut/modules.d/92tpm-unlock; \
    rm -f /etc/runlevels/*/horcrux-api /etc/runlevels/*/horcrux-guests /etc/runlevels/*/horcrux-ha-fence; \
    rm -rf /usr/share/live-installer; \
    emerge --oneshot --usepkg=n --getbinpkg=n sys-kernel/horcrux-unlock sys-apps/horcrux-tools sys-apps/horcrux-live-data sys-kernel/horcrux-hogsmeade-config; \
    # explicit packages go into @world, so `emerge -uDN @world` keeps them current and depclean never removes them
    emerge --noreplace --select=y sys-kernel/gentoo-kernel sys-fs/zfs sys-fs/zfs-kmod x11-drivers/nvidia-drivers sys-kernel/horcrux-unlock sys-kernel/horcrux-hogsmeade-config \
        sys-apps/horcrux-tools sys-apps/horcrux-live-data

# the owner's applications + the HOGSMEADE packages (binhost binpkgs where USE matches, the rest compiles)
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    emerge --update --newuse --usepkg --getbinpkg --keep-going \
        sys-firmware/sof-firmware sys-power/switcheroo-control x11-apps/mesa-progs sys-apps/smartmontools sys-apps/nvme-cli app-backup/restic \
        app-containers/docker app-containers/docker-compose app-containers/docker-buildx \
        net-misc/remmina media-gfx/gimp media-gfx/geeqie net-misc/mosh net-analyzer/nmap net-analyzer/rustscan \
        net-im/discord net-vpn/proton-vpn-gtk-app app-misc/hogsmeade-obs app-misc/hogsmeade-nextcloud app-misc/hogsmeade-speaker-tuning app-misc/hogsmeade-input-quirks app-admin/rustinion-agent sys-firmware/edk2-bin app-admin/sudo \
        sys-process/cronie app-portage/portage-utils app-portage/eix sys-apps/lm-sensors x11-libs/libnotify \
        > /var/log/hogsmeade-apps.log 2>&1 || { tail -60 /var/log/hogsmeade-apps.log; exit 1; }
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    emerge --update --newuse --usepkg app-misc/hogsmeade-tools app-misc/awccd app-misc/alienfx \
        > /var/log/hogsmeade-tools.log 2>&1 || { tail -60 /var/log/hogsmeade-tools.log; exit 1; }
# SSH CA (owner rule: one key per device generated ON the device, CA certs grant access, no per-host key registration). The image carries the
# client (ctg-ssh-ca + its cron renew), the fleet trust data (host CA @cert-authority, user CA, KRL, signer address) and ctg-ops[private-overlay]
# (registers ::ctg-private for later syncs). NO KEY OR CERTIFICATE is in the image: after the install run `ctg-ssh-ca enroll` and approve it on
# crystalcave (see owner-device-os-conversion). ::ctg-private is a plain build-time copy here (first boot replaces it with a git checkout).
COPY --from=ctgprivate / /var/db/repos/ctg-private/
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    printf '[ctg-private]\nlocation = /var/db/repos/ctg-private\nmasters = gentoo\nauto-sync = no\n' > /etc/portage/repos.conf/zz-ctg-private-seed.conf; \
    emerge --update --newuse --usepkg --select app-admin/ctg-ops net-misc/ctg-ssh-ca-fleet app-misc/hogsmeade-ssh-ca \
        > /var/log/hogsmeade-ssh-ca.log 2>&1 || { tail -60 /var/log/hogsmeade-ssh-ca.log; exit 1; }; \
    rm -f /etc/portage/repos.conf/zz-ctg-private-seed.conf; \
    # ctg-ops pkg_postinst generated a deploy key: it must never be shared by every install, the first boot makes the machine's own
    rm -f /etc/ctg-private/deploy_key /etc/ctg-private/deploy_key.pub; \
    test -s /etc/ctg-ssh-ca/ca_known_hosts && test -x /usr/bin/ctg-ssh-ca && test -s /etc/portage/repos.conf/ctg-private.conf; \
    ! find /etc/ssh /root /home -name 'id_*' -o -name '*-cert.pub' 2>/dev/null | grep -q .
# ComfyUI: venv with PyTorch cu130 wheels (large download), own layer so a failure does not redo the above
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    emerge --oneshot --usepkg sci-misc/comfyui > /var/log/hogsmeade-comfyui.log 2>&1 || { tail -60 /var/log/hogsmeade-comfyui.log; exit 1; }
# private payload (handoff key, agent ssh key, backup credentials) as a machine-local package; the files come from the named context
COPY --from=hsmprivate / /var/db/repos/local/sys-apps/hogsmeade-private/files/
RUN set -e; unset ARCH; export FEATURES="-ccache"; \
    ebuild /var/db/repos/local/sys-apps/hogsmeade-private/hogsmeade-private-1.ebuild manifest; \
    emerge --oneshot sys-apps/hogsmeade-private; \
    rm -rf /var/db/repos/local/sys-apps/hogsmeade-private/files/*; \
    emerge --noreplace --select=y app-misc/hogsmeade-tools app-misc/awccd app-misc/alienfx sci-misc/comfyui sys-apps/hogsmeade-private app-misc/hogsmeade-obs app-misc/hogsmeade-nextcloud app-misc/hogsmeade-speaker-tuning app-misc/hogsmeade-input-quirks app-admin/rustinion-agent \
        app-admin/ctg-ops net-misc/ctg-ssh-ca-fleet app-misc/hogsmeade-ssh-ca app-misc/hogsmeade-sudo app-misc/hogsmeade-agent-account app-misc/hogsmeade-user-groups app-misc/hogsmeade-b2-mounts sys-firmware/sof-firmware sys-kernel/linux-firmware

# make @world consistent with the desktop profile + new USE, so the owner's first `emerge -uDN @world` is a no-op for them
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    # the kernel stays the one part 1 built (with zfs-kmod + nvidia for it): a newer 6.18.x point release in the tree is the installed machine's
    # first ordinary update (source build + module rebuild through USE=dist-kernel), not something to compile a second time inside the image build
    emerge --update --deep --newuse --usepkg --getbinpkg --with-bdeps=n --keep-going=n --exclude 'sys-kernel/gentoo-kernel virtual/dist-kernel' @world > /var/log/hogsmeade-world.log 2>&1 \
      || { tail -60 /var/log/hogsmeade-world.log; exit 1; }; \
    emerge --depclean --pretend > /var/log/hogsmeade-depclean.log 2>&1 || true; tail -5 /var/log/hogsmeade-depclean.log

# services, markers; the byte-code made by build steps (not by a package) would be unowned files: drop exactly those; horcrux-orphans gates the result
RUN set -e; unset ARCH; \
    for s in hogsmeade-firewall hogsmeade-speaker-tuning awccd nvidia-persistenced switcheroo-control smartd hogsmeade-firstboot comfyui docker cronie hogsmeade-b2-mount.ctg-storage hogsmeade-b2-mount.ctg-media hogsmeade-b2-mount.ctg-hacktheplanet; do rc-update add $s default 2>/dev/null || true; done; \
    printf 'DISPLAYMANAGER="gdm"\n' > /etc/conf.d/display-manager; \
    echo "hogsmeade" > /etc/live-iso-variant; \
    # kernel modules are always built on this machine against its own source-built kernel (own config): a binhost zfs-kmod for the same
    # version string is built against gentoo-kernel-bin and must never be installed on the first kernel update
    printf '%s\n' '# HOGSMEADE: out-of-tree kernel modules are built here against the installed kernel, never taken from the binhost' \
        'EMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --usepkg-exclude=sys-fs/zfs-kmod --usepkg-exclude=x11-drivers/nvidia-drivers"' >> /etc/portage/make.conf; \
    grep -q 'usepkg-exclude=sys-fs/zfs-kmod' /etc/portage/make.conf; \
    rm -rf /usr/bin/tiny-dfr /usr/bin/t2fanrd /usr/share/tiny-dfr /usr/share/horcrux/t2 /usr/lib/udev/rules.d/99-touchbar-*.rules /etc/init.d/tiny-dfr /etc/init.d/t2fanrd; \
    rm -f /etc/runlevels/*/tiny-dfr /etc/runlevels/*/t2fanrd; \
    rm -rf /lib/modules/*-gentoo-dist-bin /boot/*-gentoo-dist-bin* /boot/*.old; \
    horcrux-orphans | grep -E "[.]pyc$" | xargs -r rm -f; \
    find / -xdev -name __pycache__ -type d -empty -delete 2>/dev/null || true; \
    rm -rf /opt/hxt-dist /var/tmp/portage /var/cache/distfiles/* 2>/dev/null || true; \
    echo "== orphans left (must be none or allowlisted):"; horcrux-orphans | head -40; echo "== count: $(horcrux-orphans | wc -l)"
