# HOGSMEADE (app-misc/hogsmeade-microsoft): OneDrive PERSONAL account. Seeded once, never overwritten; edit freely.
sync_dir = "~/OneDrive-Personal"
skip_dotfiles = "true"
monitor_interval = "300"
monitor_fullscan_frequency = "12"
# errors are shown as desktop notifications (libnotify)
disable_notifications = "false"
notify_file_actions = "false"
