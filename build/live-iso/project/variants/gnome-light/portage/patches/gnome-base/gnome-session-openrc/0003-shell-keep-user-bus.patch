gnome-shell start_pre imports the session leader's environ, which overrides DBUS_SESSION_BUS_ADDRESS with gdm's private bus: gnome-shell ends up on a different bus than the gsd daemons and gsd-media-keys can never grab accelerators (volume keys dead)

diff -ru a/data/openrc/gnome-shell-wayland b/data/openrc/gnome-shell-wayland
--- a/data/openrc/gnome-shell-wayland	2026-06-08 18:01:57.000000000 -0700
+++ b/data/openrc/gnome-shell-wayland	2026-10-30 13:06:15.010981437 -0700
@@ -33,4 +33,8 @@
 	while read -d $'\0' line ; do
 		export "${line}"
 	done < /proc/$(cat ${_gsl_file})/environ
+
+	# the leader (gdm-wayland-session) runs under its own private bus; the session services and the
+	# gsd daemons are on the OpenRC user bus: keep the shell there or gsd-media-keys cannot grab keys
+	export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
 }
