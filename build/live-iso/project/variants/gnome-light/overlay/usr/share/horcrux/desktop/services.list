# service runlevel  - enabled by the installer on a Desktop install (OpenRC)
elogind boot
dbus default
NetworkManager default
display-manager default
bluetooth default
cupsd default
cups-browsed default
avahi-daemon default
# upower and polkit are D-Bus activated (no init script)
power-profiles-daemon default
thermald default
chronyd default
# chronyd/horcrux-timesync/horcrux-firstboot come with the server core. Machine layers append their own services (Tailscale: owner-common)
