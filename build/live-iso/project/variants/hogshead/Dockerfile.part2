# syntax=docker/dockerfile:1.4
# hogshead variant, part 2: everything after the (1 h) kernel layers. Part 1 = Dockerfile target hs-kinstall, tagged and passed as BASE,
# so changes to the overlay/ebuilds/portage config do not recompile the kernel.
ARG BASE
FROM ${BASE} AS hogshead-final
ARG ARCH=x86_64
COPY --from=hxgentoo / /var/db/repos/horcrux/
COPY project/variants/hogshead/local-repo/ /var/db/repos/local/
COPY project/variants/hogshead/portage/ /etc/portage/
RUN --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    # installer data (branding, portage-meta snapshot) generated by this image build -> fetch-restricted tarball -> a package
    tar -C / --zstd -cf /var/cache/distfiles/horcrux-live-data-1.tar.zst usr/share/live-installer; \
    for e in /var/db/repos/horcrux/sys-apps/horcrux-live-data/*.ebuild /var/db/repos/horcrux/sys-apps/horcrux-t2-audio/*.ebuild /var/db/repos/horcrux/sys-kernel/horcrux-t2-config/*.ebuild /var/db/repos/horcrux/app-admin/rustinion-bin/*.ebuild /var/db/repos/horcrux/sys-apps/t2fanrd/*.ebuild /var/db/repos/horcrux/sys-apps/tiny-dfr/*.ebuild /var/db/repos/horcrux/sys-apps/horcrux-tools/*.ebuild; do ebuild "$e" manifest; done; \
    # loose copies from the ISO overlay that packages own now (or that a laptop does not need): remove first so Portage owns the files
    rm -rf /usr/bin/horcrux /usr/bin/horcrux-api /usr/share/horcrux/ui /etc/init.d/horcrux-api /etc/init.d/horcrux-guests \
           /usr/share/horcrux/t2 /usr/share/tiny-dfr/LICENSE /usr/share/tiny-dfr/LICENSE.material /usr/lib/udev/rules.d/99-touchbar-tiny-dfr.rules \
           /usr/lib/live-installer /usr/libexec/live-* /usr/libexec/console-menu-session /usr/bin/live-installer /usr/bin/console-menu \
           /usr/bin/live-persist /usr/bin/live-rescue /usr/bin/horcrux-be /usr/bin/horcrux-t2-firmware /usr/share/horcrux/desktop; \
    rm -f /etc/runlevels/*/horcrux-api /etc/runlevels/*/horcrux-guests; \
    rm -rf /usr/share/live-installer; \
    emerge --oneshot --usepkg=n --getbinpkg=n sys-kernel/horcrux-unlock sys-apps/horcrux-tools sys-apps/horcrux-live-data sys-apps/horcrux-t2-audio sys-kernel/horcrux-t2-config; \
    # explicit packages go into @world, so `emerge -uDN @world` keeps them current and depclean never removes them
    emerge --noreplace --select=y sys-kernel/gentoo-kernel sys-fs/zfs sys-fs/zfs-kmod sys-kernel/horcrux-unlock sys-kernel/horcrux-t2-config sys-apps/horcrux-tools sys-apps/horcrux-live-data sys-apps/horcrux-t2-audio

# the owner's applications (Portage packages: binhost binpkgs where USE matches, the rest compiles)
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    emerge --update --newuse --usepkg --getbinpkg --keep-going \
        app-containers/docker app-containers/docker-compose app-containers/docker-buildx \
        net-misc/remmina media-gfx/gimp media-gfx/geeqie net-misc/mosh net-analyzer/nmap \
        net-im/discord net-vpn/proton-vpn-gtk-app app-admin/rustinion-bin sys-apps/t2fanrd sys-apps/tiny-dfr \
        app-admin/sudo sys-process/cronie app-portage/portage-utils app-portage/eix \
        > /var/log/hogshead-apps.log 2>&1 || { tail -60 /var/log/hogshead-apps.log; exit 1; }

# make @world consistent with the desktop profile + new USE (rebuilds of a few packages that were built with the server flags),
# so the owner's first `emerge -uDN @world` is a no-op for them; the kernel stays (7.2.13 is the newest 7.2.x in the tree)
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; export FEATURES="-ccache buildpkg"; \
    emerge --update --deep --newuse --usepkg --getbinpkg --with-bdeps=n --keep-going=n @world > /var/log/hogshead-world.log 2>&1 \
      || { tail -60 /var/log/hogshead-world.log; exit 1; }; \
    emerge --depclean --pretend > /var/log/hogshead-depclean.log 2>&1 || true; tail -5 /var/log/hogshead-depclean.log

# optional heavy extras: failures are logged, never silent
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH:-x86_64},target=/var/cache/distfiles,sharing=locked \
    unset ARCH; export FEATURES="-ccache buildpkg"; \
    for p in app-emulation/libguestfs app-emulation/libguestfs-appliance; do \
      emerge --update --newuse --usepkg --getbinpkg $p > /var/log/hogshead-opt-$(basename $p).log 2>&1 \
        && echo "OPTIONAL-OK $p" || echo "OPTIONAL-FAILED $p"; \
    done | tee /etc/hogshead-optional.txt; true

RUN set -e; for s in docker t2fanrd tiny-dfr; do rc-update add $s default || true; done; \
    # leftovers of the stock binary kernel that was unmerged (its modules dir kept the zfs.ko built for it) and the .old copies
    rm -rf /lib/modules/6.18.57-gentoo-dist-bin /boot/*6.18.57-gentoo-dist-bin* /boot/*.old; \
    echo "hogshead" >> /etc/live-iso-variant; \
    # byte-code made by build steps (not by a package) would be unowned files: drop exactly those, keep the packages' own
    horcrux-orphans | grep -E "[.]pyc$" | xargs -r rm -f; \
    find / -xdev -name __pycache__ -type d -empty -delete 2>/dev/null || true; \
    rm -rf /var/tmp/portage /var/cache/distfiles/* 2>/dev/null || true

# binary packages of what this variant built (kernel, zfs, horcrux-unlock, rustinion, config): a binhost-ready PKGDIR
FROM hogshead-final AS binpkgs-build
RUN --mount=type=cache,id=binpkgs-${ARCH:-x86_64},target=/var/cache/binpkgs,sharing=locked \
    mkdir -p /export/sys-kernel /export/sys-fs /export/app-admin; \
    cp -a /var/cache/binpkgs/sys-kernel/horcrux-* /var/cache/binpkgs/sys-kernel/gentoo-kernel-7.2.13* /export/sys-kernel/ 2>/dev/null; \
    cp -a /var/cache/binpkgs/sys-fs/zfs-2.3.9* /var/cache/binpkgs/sys-fs/zfs-kmod-2.3.9* /export/sys-fs/ 2>/dev/null; \
    cp -a /var/cache/binpkgs/app-admin/rustinion-bin* /export/app-admin/ 2>/dev/null; \
    cp -a /var/cache/binpkgs/Packages /export/ 2>/dev/null; find /export -type f | head -50

FROM scratch AS binpkgs-export
COPY --from=binpkgs-build /export /
