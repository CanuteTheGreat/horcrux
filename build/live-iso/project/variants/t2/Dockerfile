# syntax=docker/dockerfile:1.4
# Horcrux Apple T2 variant: the finished rootfs (BASE: server or desktop) + the T2 kernel, so that the live USB has a working
# internal keyboard/trackpad on a T2 Mac and the installed system boots with it (apple-bce in the initramfs).
#
#   kernel  = gentoo-sources 7.2.13 + the pinned t2linux patch set (gentoo/t2/PATCHSET: OpenZFS 2.3.9/2.4.4 support <= 7.2)
#   config  = Gentoo's dist-kernel config + gentoo/t2/kernel/t2.config + the patch set's extra_config, asserted by required-config.txt
#   zfs.ko  = sys-fs/zfs-kmod built out of tree against that kernel (the live installer creates the pool with the RUNNING kernel)
#   initrd  = dracut with apple-bce + HID loaded early (liveinst/t2.py: dracut_conf) - the build FAILS when they are not inside
#
# The T2 kernel REPLACES the stock gentoo-kernel-bin: assemble-iso.sh boots the newest kernel in /lib/modules.
# Apple Wi-Fi/Bluetooth firmware is never part of this image (liveinst/t2.py imports it at install time).
# Named build context `t2` = the repository's gentoo/t2 (build.sh passes it).
ARG BASE
FROM ${BASE}
ARG ARCH=x86_64
ARG VARIANT=t2

COPY --from=t2 / /t2/
COPY project/variants/t2/portage/ /etc/portage/

RUN --mount=type=cache,id=binpkgs-${ARCH},target=/var/cache/binpkgs,sharing=locked \
    --mount=type=cache,id=distfiles-${ARCH},target=/var/cache/distfiles,sharing=locked \
    set -e; unset ARCH; \
    [ "$(uname -m)" = x86_64 ] || { echo "the T2 variant is x86_64 only"; exit 1; }; \
    emerge-webrsync -q || emerge --sync -q; \
    export FEATURES="-ccache"; \
    . /t2/PATCHSET; \
    emerge --oneshot ${KERNEL_PKG} sys-devel/bc dev-libs/elfutils sys-apps/kmod app-alternatives/cpio dev-libs/openssl dev-vcs/git; \
    FEATURES="-sandbox -usersandbox -network-sandbox -pid-sandbox -ipc-sandbox" \
    ebuild $(ls /var/db/repos/gentoo/sys-kernel/gentoo-kernel-bin/gentoo-kernel-bin-*.ebuild | sort -V | tail -1) clean unpack; \
    cp $(find /var/tmp/portage/sys-kernel -path '*dist-bin/.config' | head -1) /dist.config; \
    rm -rf /var/tmp/portage/sys-kernel; \
    sh /t2/kernel/fetch-patches.sh /t2patches; \
    PATCHES=/t2patches KERNEL_SRC_DIR=${KERNEL_SRC_DIR} LOCALVERSION=${LOCALVERSION} sh /t2/kernel/build-kernel.sh > /build-kernel.log 2>&1 \
        || { tail -100 /build-kernel.log; exit 1; }; \
    tail -5 /build-kernel.log; \
    ln -sfn ${KERNEL_SRC_DIR} /usr/src/linux; \
    kr=$(cat /boot/.kernelrelease); \
    emerge --oneshot =sys-fs/zfs-kmod-2.3.9 =sys-fs/zfs-2.3.9; \
    find /lib/modules/$kr -name 'zfs.ko*' | grep .; depmod $kr; \
    # the stock kernel goes: its modules/kernel are ~650 MB and the T2 kernel must be the one the live ISO boots
    for old in $(ls /lib/modules | grep -v -- "-t2"); do rm -rf /lib/modules/$old /boot/*-$old* /boot/*-$old; done; \
    ls /boot /lib/modules

# initramfs (live + install): T2 modules first. The dracut/modprobe/modules-load files are generated by the installer's own
# t2.py, so the live image and the installed system use the same list.
COPY project/variants/t2/t2-write-config.py project/variants/t2/t2-check-initramfs.py /usr/local/lib/t2/
RUN set -e; kr=$(cat /boot/.kernelrelease); \
    python3 /usr/local/lib/t2/t2-write-config.py; \
    dracut -f --no-hostonly --kver "$kr" "/boot/initramfs-$kr.img" "$kr"; \
    lsinitrd "/boot/initramfs-$kr.img" > /etc/live-iso-t2-initramfs.lst; \
    python3 /usr/local/lib/t2/t2-check-initramfs.py /etc/live-iso-t2-initramfs.lst; \
    grep -E "t2bce|hid_apple|hid-apple|appletb|zfs" /etc/live-iso-t2-initramfs.lst | sed -n 1,40p; \
    echo "t2" >> /etc/live-iso-variant; \
    rm -rf /usr/local/lib/t2 /usr/src/linux-* /usr/src/linux /var/db/repos/gentoo/* /var/cache/distfiles/* /var/tmp/portage /build-kernel.log /t2patches /t2 /dist.config 2>/dev/null || true; \
    find / -xdev -name '*.pyc' -path '*/__pycache__/*' -delete 2>/dev/null || true
