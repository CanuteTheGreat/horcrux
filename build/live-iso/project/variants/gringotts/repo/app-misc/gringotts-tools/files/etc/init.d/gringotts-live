#!/sbin/openrc-run
# Live stick only: the tty1 console gets the gringotts menu instead of the stock installer picker.
description="gringotts live stick: tty1 menu (install / Wi-Fi / remote)"
depend() { need localmount; after live-installer live-serial; }
start() {
	grep -q 'rd.live.image' /proc/cmdline || return 0
	mode=$(cat /run/live-installer/mode 2>/dev/null)
	case "$mode" in gui|text) ;; *) return 0 ;; esac
	[ -x /usr/libexec/live-serial-dev ] && /usr/libexec/live-serial-dev >/dev/null && [ "$mode" != gui ] && return 0
	sed -i '/^c1:/d' /etc/inittab
	echo "c1:12345:respawn:/sbin/agetty --noclear -n -l /usr/libexec/gringotts-session 38400 tty1 linux" >> /etc/inittab
	telinit q 2>/dev/null
	pkill -f 'agetty.* tty1' 2>/dev/null
	hostname gringotts-live 2>/dev/null
	return 0
}
