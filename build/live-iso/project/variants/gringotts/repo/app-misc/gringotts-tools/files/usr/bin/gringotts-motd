#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
B=$(printf '\033[1m'); N=$(printf '\033[0m')
lan=$(ip -4 -o addr show scope global 2>/dev/null | awk '{split($4,a,"/"); printf "%s(%s) ", a[1], $2}')
wifi=$(nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | awk -F: '$2=="wifi"{print $1": "$3}')
echo
echo "${B}HORCRUX for gringotts${N}  (ThinkBook 16 G6; kernel $(uname -r), OpenZFS $(cat /sys/module/zfs/version 2>/dev/null || echo '-'))"
echo "----------------------------------------------------------------------------------"
echo " LAN IP: ${lan:-none yet}   Wi-Fi: ${wifi:-no wifi device}   Name: $(hostname).home.canutethegreat.com"
echo "----------------------------------------------------------------------------------"
