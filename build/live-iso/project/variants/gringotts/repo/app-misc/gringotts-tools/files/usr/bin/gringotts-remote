#!/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# gringotts-remote: start sshd (key-only) and join Tailscale non-interactively with the key baked into the PRIVATE image
# (ephemeral, tagged, pre-authorised, 7 days). Needs a working network first (nmtui for Wi-Fi). Prints the IPs to tell Claude.
# Works on the live stick (node gringotts-live) and on the installed system (node gringotts).
set -u
[ "$(id -u)" = 0 ] || { echo "run as root (sudo gringotts-remote)"; exit 1; }
SOCK=/run/tailscale/tailscaled.sock
KEY=/usr/share/gringotts/ts-authkey
[ -s /run/gringotts-keys/ts-authkey ] && KEY=/run/gringotts-keys/ts-authkey
if grep -q rd.live.image /proc/cmdline 2>/dev/null; then HOST=gringotts-live; else HOST=gringotts; fi
ts() { tailscale --socket=$SOCK "$@"; }
lanips() { ip -4 -o addr show scope global 2>/dev/null | awk '$2!="tailscale0"{split($4,a,"/"); print "  " a[1] "  (" $2 ")"}'; }

echo "== network"
if ! ip -4 route show default | grep -q .; then
  echo "No default route: the laptop is not online yet."
  echo "  Wi-Fi:     nmtui   (Activate a connection)     Ethernet/USB-C dongle: plug it in, DHCP is automatic"
  exit 1
fi
ip -4 route show default | head -2
echo "== sshd (key-only)"
rc-service sshd status >/dev/null 2>&1 || rc-service sshd start >/dev/null 2>&1
rc-service sshd status 2>&1 | tail -1
echo "== clock"
# a live stick can boot with a clock months off; TLS (tailscale, curl) fails on a wrong date. A plain-HTTP Date header needs no certificate.
d=$(curl -sI -m 8 http://www.google.com 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: //p' | head -1)
if [ -n "$d" ] && date -u -s "$d" >/dev/null 2>&1; then echo "clock set to: $(date -u)"; hwclock -w -u 2>/dev/null; else echo "clock left as: $(date -u) (no plain-HTTP time source reachable)"; fi
echo "== tailscale"
modprobe tun 2>/dev/null
SVC=tailscale
[ -x /etc/init.d/tailscale ] || SVC=tailscaled
rc-service $SVC status >/dev/null 2>&1 || rc-service $SVC start >/dev/null 2>&1
i=0; while [ ! -S $SOCK ] && [ $i -lt 30 ]; do sleep 0.5; i=$((i+1)); done
if ts status --json 2>/dev/null | grep -q '"BackendState": "Running"'; then
  echo "already connected"
else
  if [ ! -s "$KEY" ]; then
    echo "No auth key on this image ($KEY missing: public build, or the private bundle was removed)."
    echo "Run:  tailscale up --hostname=$HOST   and open the printed URL on another device."
  else
    # the key is passed as a file so it never shows up in the process list or the shell history
    if ! ts up --auth-key="file:$KEY" --hostname="$HOST" --accept-dns=false --accept-routes=false --ssh=false --timeout=90s; then
      echo
      echo "Tailscale refused the key (expired after 7 days?)."
      echo "Fallback: plain LAN ssh (below), or  tailscale up --hostname=$HOST  and open the URL."
    fi
  fi
fi
tsip=$(ts ip -4 2>/dev/null | head -1)
echo
echo "================= give these to Claude ================="
echo "Tailscale IP : ${tsip:-<not connected>}"
echo "LAN IP(s)    :"; lanips
echo "ssh          : key-only (root@<ip> or canutethegreat@<ip>)   node: $HOST"
echo "========================================================="
[ -n "$tsip" ]
